<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:view="clr-namespace:CenterHubNew.MVVM.View"
        xmlns:viewmodel="clr-namespace:CenterHubNew.MVVM.ViewModel"
        x:Class="CenterHubNew.MainWindow"
        x:DataType="viewmodel:MainViewModel"
        mc:Ignorable="d"
        Height="880" Width="1360"
        MinHeight="420" MinWidth="480"
        SystemDecorations="Full"
        TransparencyLevelHint="Mica,AcrylicBlur"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        CanResize="True"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="PreferSystemChrome"
        ExtendClientAreaTitleBarHeightHint="46">

    <!-- No outer rounded frame: Windows 11 rounds and shadows the window itself. -->
    <Grid RowDefinitions="Auto,*" Background="{DynamicResource BackgroundDarkBrush}">

        <!-- ===== TITLE BAR (not scaled by the UI zoom) =====
             Windows draws the native minimize / maximize / close buttons over the right edge,
             so the last column reserves room for them. -->
        <Border Grid.Row="0"
                Background="{DynamicResource TitleBarBackgroundBrush}"
                BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource BorderHairline}"
                PointerPressed="TitleBar_PointerPressed">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" Height="46">

                <!-- Hamburger: opens the sidebar drawer when the window is too narrow for a column -->
                <Button Grid.Column="0"
                        Classes="chrome"
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        IsVisible="{Binding IsSidebarHidden}"
                        Command="{Binding ToggleDrawerCommand}"
                        ToolTip.Tip="Menu">
                    <TextBlock Text="&#xE700;"
                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets, Segoe UI Symbol"
                               FontSize="16"/>
                </Button>

                <!-- App identity -->
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="16,0,0,0"
                            Spacing="10">
                    <!-- Dot logo -->
                    <Border Width="22" Height="22" CornerRadius="11"
                            Background="{DynamicResource AccentBrush}"
                            VerticalAlignment="Center">
                        <Border Width="8" Height="8" CornerRadius="4"
                                Background="{DynamicResource TextOnAccentBrush}"
                                HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="CenterHub"
                               FontSize="15" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding AppVersion}"
                               FontSize="11"
                               Foreground="{DynamicResource TextMutedBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Favorites -->
                <Button Grid.Column="3"
                        Classes="chrome"
                        FontSize="14"
                        VerticalAlignment="Center"
                        Margin="0,0,6,0"
                        Foreground="{DynamicResource TextMutedBrush}"
                        Click="FavoritesButton_Click"
                        ToolTip.Tip="Favorites Panel">
                    <TextBlock Text="&#x2605;" FontSize="14"/>
                </Button>

                <!-- Space under the system caption buttons (resized from WindowDecorationMargin) -->
                <Border Grid.Column="4" x:Name="CaptionSpacer" Width="150" IsHitTestVisible="False"/>
            </Grid>
        </Border>

        <!-- ===== EVERYTHING BELOW THE TITLE BAR — scaled by the UI zoom ===== -->
        <LayoutTransformControl Grid.Row="1" LayoutTransform="{Binding ZoomTransform}">
            <Grid x:Name="ContentRoot"
                  RowDefinitions="Auto,*"
                  Classes.compact="{Binding IsCompact}">

            <!-- ===== UPDATE BANNER ===== -->
            <Border Grid.Row="0"
                    Background="{DynamicResource AccentSubtleBrush}"
                    BorderThickness="0,0,0,1"
                    BorderBrush="{DynamicResource AccentBrush}"
                    Padding="20,10"
                    IsVisible="{Binding IsUpdateAvailable}">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto" RowDefinitions="Auto,Auto">

                    <!-- Status icon -->
                    <Border Grid.Column="0" Grid.RowSpan="2"
                            Width="34" Height="34" CornerRadius="10"
                            Background="{DynamicResource AccentBrush}"
                            VerticalAlignment="Center" Margin="0,0,14,0">
                        <TextBlock Text="&#xE895;"
                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets, Segoe UI Symbol"
                                   FontSize="17"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextOnAccentBrush}"/>
                    </Border>

                    <!-- Headline + body preview -->
                    <StackPanel Grid.Column="1" Grid.RowSpan="2" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="Update available —"
                                       FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding UpdateHeadline}"
                                       FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource AccentHoverBrush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="{Binding UpdateBodyPreview}"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   MaxWidth="700"
                                   HorizontalAlignment="Left"
                                   Margin="0,2,0,0"
                                   IsVisible="{Binding !IsDownloadingUpdate}"/>
                        <ProgressBar Value="{Binding DownloadProgressPercent}"
                                     Maximum="100"
                                     Height="4"
                                     MinWidth="240"
                                     HorizontalAlignment="Left"
                                     Margin="0,6,0,0"
                                     Foreground="{DynamicResource AccentBrush}"
                                     IsVisible="{Binding IsDownloadingUpdate}"/>
                    </StackPanel>

                    <!-- Action buttons -->
                    <StackPanel Grid.Column="2" Grid.RowSpan="2" Orientation="Horizontal" Spacing="6"
                                VerticalAlignment="Center" Margin="14,0,0,0">
                        <Button Classes="primary" Padding="14,7" FontSize="12"
                                Content="{Binding UpdateActionText}"
                                Command="{Binding DownloadAndInstallUpdateCommand}"
                                IsEnabled="{Binding !IsDownloadingUpdate}"/>
                        <Button Classes="secondary" Padding="12,7" FontSize="12"
                                Content="Skip this version"
                                ToolTip.Tip="Don't show this version again — wait for the next one"
                                Command="{Binding SkipUpdateCommand}"
                                IsEnabled="{Binding !IsDownloadingUpdate}"/>
                    </StackPanel>

                    <Button Grid.Column="3" Grid.RowSpan="2"
                            Classes="ghost" Padding="8,7"
                            VerticalAlignment="Center" Margin="4,0,0,0"
                            ToolTip.Tip="Hide until next launch"
                            Command="{Binding DismissUpdateCommand}"
                            IsEnabled="{Binding !IsDownloadingUpdate}">
                        <TextBlock Text="&#xE894;"
                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets, Segoe UI Symbol"
                                   FontSize="14"
                                   Foreground="{DynamicResource TextMutedBrush}"/>
                    </Button>
                </Grid>
            </Border>

            <!-- ===== MAIN LAYOUT: sidebar + content (+ status strip) ===== -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{Binding SidebarWidth}"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- CONTENT AREA (Mica shows through) -->
                <Grid Grid.Column="1" Background="Transparent" RowDefinitions="*,Auto">
                    <ContentControl Grid.Row="0" Content="{Binding CurrentView}"/>
                    <!-- Bottom-right, in the row above the status strip, so toasts never cover
                         page-header action buttons or the strip. -->
                    <view:ToastContainer Grid.Row="0"
                                         HorizontalAlignment="Right"
                                         VerticalAlignment="Bottom"
                                         Margin="0,0,16,16"/>
                    <!-- Status strip slot -->
                    <ContentControl Grid.Row="1"
                                    Content="{Binding StatusStrip}"
                                    IsVisible="{Binding IsStatusStripVisible}"/>
                </Grid>

                <!-- Drawer backdrop (only while the sidebar is a drawer and open) -->
                <Border Grid.ColumnSpan="2"
                        Background="#80000000"
                        ZIndex="40"
                        IsVisible="{Binding IsDrawerOpen}"
                        PointerPressed="DrawerBackdrop_PointerPressed"/>

                <!-- SIDEBAR. One instance for every mode: the grid column sets its footprint,
                     and as a drawer it simply overlays the content. -->
                <Border x:Name="SidebarPanel"
                        Grid.ColumnSpan="2"
                        HorizontalAlignment="Left"
                        ZIndex="50"
                        Width="{Binding SidebarPanelWidth}"
                        IsVisible="{Binding IsSidebarPanelVisible}"
                        Classes.rail="{Binding IsSidebarRail}"
                        Background="{DynamicResource SidebarBackgroundBrush}"
                        BorderThickness="0,0,1,0"
                        BorderBrush="{DynamicResource BorderHairline}">
                    <Grid RowDefinitions="*,Auto">

                        <ScrollViewer Grid.Row="0"
                                      VerticalScrollBarVisibility="Hidden"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Padding="0,6,0,0">
                            <ItemsControl ItemsSource="{Binding NavGroups}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="viewmodel:NavGroupViewModel">
                                        <StackPanel Margin="0,0,0,6">
                                            <TextBlock Classes="navheader"
                                                       Text="{Binding DisplayHeader}"/>
                                            <ItemsControl ItemsSource="{Binding Items}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="viewmodel:NavItemViewModel">
                                                        <RadioButton Classes="navtab"
                                                                     GroupName="Nav"
                                                                     Content="{Binding Title}"
                                                                     Tag="{Binding Glyph}"
                                                                     ToolTip.Tip="{Binding Tooltip}"
                                                                     IsChecked="{Binding IsSelected, Mode=TwoWay}"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- Collapse / expand button (Expanded <-> Rail) -->
                        <Button Grid.Row="1"
                                Command="{Binding ToggleSidebarCommand}"
                                IsVisible="{Binding !IsSidebarHidden}"
                                ToolTip.Tip="{Binding SidebarToggleTooltip}"
                                Cursor="Hand"
                                Margin="8,0,8,16"
                                Classes="secondary"
                                Padding="8,7"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center">
                            <TextBlock Text="{Binding SidebarToggleIcon}"
                                       FontSize="13"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       HorizontalAlignment="Center"/>
                        </Button>
                    </Grid>
                </Border>
            </Grid>

            <!-- ===== "WHAT'S NEW" POPUP (after an update) ===== -->
            <Border Grid.RowSpan="2"
                    Background="#A8000000"
                    IsVisible="{Binding IsWhatsNewOpen}"
                    ZIndex="1100">
                <Border Width="560" MaxHeight="620"
                        Background="{DynamicResource CardBackgroundBrush}"
                        BorderThickness="1" BorderBrush="{DynamicResource BorderHairline}"
                        CornerRadius="12"
                        Padding="28,24"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        BoxShadow="0 12 40 0 #80000000">
                    <Grid RowDefinitions="Auto,*,Auto">
                        <!-- Header -->
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12" Margin="0,0,0,16">
                            <Border Width="36" Height="36" CornerRadius="18"
                                    Background="{DynamicResource AccentSubtleBrush}"
                                    BorderThickness="1" BorderBrush="{DynamicResource AccentBrush}"
                                    VerticalAlignment="Center">
                                <TextBlock Text="&#xE789;" FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets"
                                           FontSize="16"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{DynamicResource AccentBrush}"/>
                            </Border>
                            <TextBlock Text="{Binding WhatsNewTitle}"
                                       FontSize="18" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Release notes -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <SelectableTextBlock Text="{Binding WhatsNewBody}"
                                                 TextWrapping="Wrap"
                                                 FontSize="13" LineHeight="20"
                                                 Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </ScrollViewer>

                        <!-- Actions -->
                        <StackPanel Grid.Row="2" Orientation="Horizontal"
                                    HorizontalAlignment="Right" Spacing="10" Margin="0,20,0,0">
                            <Button Content="Got it" Classes="primary"
                                    Padding="22,10"
                                    Command="{Binding CloseWhatsNewCommand}"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Border>

            <!-- ===== VOICEMEETER AUDIO-RESTORE PROMPT (after a crash) ===== -->
            <Border Grid.RowSpan="2"
                    Background="#A8000000"
                    IsVisible="{Binding IsAudioRestoreOpen}"
                    ZIndex="1200">
                <Border Width="440"
                        Background="{DynamicResource CardBackgroundBrush}"
                        BorderThickness="1" BorderBrush="{DynamicResource BorderHairline}"
                        CornerRadius="12"
                        Padding="28,24"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        BoxShadow="0 12 40 0 #80000000">
                    <StackPanel Spacing="0">
                        <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,0,0,12">
                            <Border Width="36" Height="36" CornerRadius="18"
                                    Background="{DynamicResource AccentSubtleBrush}"
                                    BorderThickness="1" BorderBrush="{DynamicResource AccentBrush}"
                                    VerticalAlignment="Center">
                                <TextBlock Text="&#xE7F3;" FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets"
                                           FontSize="16"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{DynamicResource AccentBrush}"/>
                            </Border>
                            <TextBlock Text="Voicemeeter isn't running"
                                       FontSize="18" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <TextBlock Text="{Binding AudioRestoreBody}"
                                   TextWrapping="Wrap" FontSize="13"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="0,0,0,22"/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
                            <Button Content="Not now" Classes="secondary"
                                    Padding="18,10"
                                    Command="{Binding DismissAudioRestoreCommand}"/>
                            <Button Content="Use previous devices" Classes="secondary"
                                    Padding="18,10"
                                    Command="{Binding RestoreAudioNowCommand}"/>
                            <Button Content="Start Voicemeeter" Classes="primary"
                                    Padding="18,10"
                                    Command="{Binding StartVoicemeeterNowCommand}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Border>


            <!-- ===== OVERLAY LAYER (command palette, setup wizard) ===== -->
            <Border x:Name="OverlayLayer"
                    Grid.RowSpan="2"
                    Background="#A8000000"
                    IsVisible="{Binding HasOverlay}"
                    ZIndex="1300"
                    PointerPressed="OverlayBackdrop_PointerPressed">
                <ContentControl Content="{Binding Overlay}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
            </Border>

            </Grid>
        </LayoutTransformControl>
    </Grid>
</Window>
