<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewmodel="clr-namespace:CenterHubNew.MVVM.ViewModel"
        xmlns:controls="clr-namespace:CenterHubNew.MVVM.Controls"
        xmlns:dash="clr-namespace:CenterHubNew.MVVM.View.Dashboard"
        x:Class="CenterHubNew.MVVM.View.FavoritesWindow"
        x:DataType="viewmodel:FavoritesViewModel"
        mc:Ignorable="d"
        Title="Favorites"
        Width="350" Height="500"
        MinWidth="300" MinHeight="260"
        CanResize="True"
        SystemDecorations="None"
        TransparencyLevelHint="Mica,AcrylicBlur"
        ExtendClientAreaToDecorationsHint="True"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        Background="Transparent">

    <!-- Compact always-on-top panel: the cards of UiSettings.FavoritesCards (default system, volume,
         metronome) in one column, two when the window is wide. The same card views as the Home page. -->

    <!-- Outer frame (Mica subtly visible through) -->
    <Border Background="{DynamicResource BackgroundDarkBrush}"
            CornerRadius="8"
            BorderThickness="1"
            BorderBrush="{DynamicResource BorderHairline}">
        <Grid>
            <Grid RowDefinitions="46,*" ClipToBounds="True">

                <!-- TITLE BAR -->
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto"
                      PointerPressed="TitleBar_PointerPressed">
                    <Border Grid.ColumnSpan="3"
                            Background="{DynamicResource TitleBarBackgroundBrush}"
                            CornerRadius="8,8,0,0"/>

                    <!-- App dot + title -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal"
                                VerticalAlignment="Center" Margin="14,0,0,0" Spacing="8">
                        <Border Width="16" Height="16" CornerRadius="8"
                                Background="{DynamicResource AccentBrush}" VerticalAlignment="Center">
                            <Border Width="6" Height="6" CornerRadius="3"
                                    Background="{DynamicResource TextOnAccentBrush}"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Favorites" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Edit cards (pencil) / done (check) -->
                    <Button Grid.Column="1" Classes="chrome"
                            Width="32" Height="32" Margin="0,0,2,0"
                            Command="{Binding Editor.ToggleEditCommand}"
                            ToolTip.Tip="Edit cards">
                        <Panel>
                            <TextBlock Text="&#xE70F;" FontSize="13"
                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets, Segoe UI Symbol"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       IsVisible="{Binding !Editor.IsEditing}"/>
                            <TextBlock Text="&#xE73E;" FontSize="13"
                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets, Segoe UI Symbol"
                                       Foreground="{DynamicResource AccentBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       IsVisible="{Binding Editor.IsEditing}"/>
                        </Panel>
                    </Button>

                    <!-- Close button -->
                    <Button Grid.Column="2" Classes="chrome"
                            Width="32" Height="32" Margin="0,0,8,0"
                            Click="CloseButton_Click"
                            ToolTip.Tip="Close">
                        <TextBlock Text="&#xD7;" FontSize="15"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                </Grid>

                <!-- CONTENT -->
                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="12,12,12,12">
                    <StackPanel Spacing="12" Margin="0,0,0,12">
                        <ItemsControl ItemsSource="{Binding Editor.Cards}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <!-- 2 columns need 2 x 310 + 12 + 24 padding = 656 px -->
                                    <controls:AdaptiveColumnsPanel MinColumnWidth="310" MaxColumns="2"
                                                                   ColumnSpacing="12" RowSpacing="12"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <dash:CardView/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <dash:AddCardsView DataContext="{Binding Editor}"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- Resize grips (the window has no system frame): right edge, bottom edge, bottom-right corner -->
            <Border HorizontalAlignment="Right" VerticalAlignment="Stretch" Width="5" Margin="0,46,0,14"
                    Background="Transparent" Cursor="SizeWestEast"
                    PointerPressed="ResizeRight_PointerPressed"/>
            <Border HorizontalAlignment="Stretch" VerticalAlignment="Bottom" Height="5" Margin="0,0,14,0"
                    Background="Transparent" Cursor="SizeNorthSouth"
                    PointerPressed="ResizeBottom_PointerPressed"/>
            <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="14" Height="14"
                    Background="Transparent" Cursor="BottomRightCorner"
                    PointerPressed="ResizeCorner_PointerPressed"/>
        </Grid>
    </Border>
</Window>
