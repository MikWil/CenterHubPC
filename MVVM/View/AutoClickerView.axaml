<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewmodel="clr-namespace:CenterHubNew.MVVM.ViewModel"
             xmlns:local="clr-namespace:CenterHubNew.MVVM.View"
             xmlns:conv="clr-namespace:CenterHubNew.MVVM.Converters"
             xmlns:controls="clr-namespace:CenterHubNew.MVVM.Controls"
             x:Class="CenterHubNew.MVVM.View.AutoClickerView"
             x:DataType="viewmodel:AutoClickerViewModel"
             controls:Responsive.NarrowBelow="600"
             mc:Ignorable="d"
             Background="Transparent">

    <UserControl.Resources>
        <local:BoolToRunningTextConverter x:Key="BoolToRunningTextConverter"/>
        <local:BoolToRunningBrushConverter x:Key="BoolToRunningBrushConverter"/>
        <conv:FlexibleDoubleConverter x:Key="FlexDouble"/>
        <conv:FlexibleIntConverter x:Key="FlexInt"/>
    </UserControl.Resources>

    <UserControl.Styles>
        <!-- Live status panel: counter | message | elapsed | Stop on one row; below 600 px the message drops to its own row. -->
        <Style Selector="StackPanel.st-msg">
            <Setter Property="Grid.Row" Value="0"/>
            <Setter Property="Grid.Column" Value="1"/>
            <Setter Property="Grid.ColumnSpan" Value="1"/>
            <Setter Property="Margin" Value="20,0,0,0"/>
        </Style>
        <Style Selector="StackPanel.st-elapsed">
            <Setter Property="Grid.Column" Value="2"/>
            <Setter Property="Margin" Value="20,0,16,0"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>
        <Style Selector="UserControl:narrow StackPanel.st-msg">
            <Setter Property="Grid.Row" Value="1"/>
            <Setter Property="Grid.Column" Value="0"/>
            <Setter Property="Grid.ColumnSpan" Value="4"/>
            <Setter Property="Margin" Value="0,10,0,0"/>
        </Style>
        <Style Selector="UserControl:narrow StackPanel.st-elapsed">
            <Setter Property="Grid.Column" Value="1"/>
            <Setter Property="Margin" Value="0,0,16,0"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>

        <!-- Actions card: buttons | status text; below 600 px the status text goes under the buttons. -->
        <Style Selector="TextBlock.act-status">
            <Setter Property="Grid.Row" Value="0"/>
            <Setter Property="Grid.Column" Value="1"/>
            <Setter Property="Grid.ColumnSpan" Value="1"/>
            <Setter Property="Margin" Value="16,0,0,0"/>
        </Style>
        <Style Selector="UserControl:narrow TextBlock.act-status">
            <Setter Property="Grid.Row" Value="1"/>
            <Setter Property="Grid.Column" Value="0"/>
            <Setter Property="Grid.ColumnSpan" Value="2"/>
            <Setter Property="Margin" Value="0,10,0,0"/>
        </Style>
    </UserControl.Styles>

    <controls:PageHost Title="Auto Clicker"
                       Subtitle="Send clicks at an interval — without fighting your cursor"
                       Mode="Reading">
        <controls:PageHost.HeaderBadge>
            <Border Background="{Binding IsRunning, Converter={StaticResource BoolToRunningBrushConverter}}"
                    CornerRadius="5" Padding="10,4">
                <TextBlock Text="{Binding IsRunning, Converter={StaticResource BoolToRunningTextConverter}}"
                           FontSize="10" FontWeight="Bold" LetterSpacing="0.5"
                           Foreground="White"/>
            </Border>
        </controls:PageHost.HeaderBadge>

        <StackPanel Spacing="0">

            <!-- ===== LIVE STATUS PANEL (visible while arming or running) ===== -->
            <Border Classes="card" Margin="0,0,0,10"
                    IsVisible="{Binding IsRunning}">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto" RowDefinitions="Auto,Auto">
                    <!-- Big arm countdown OR live counter -->
                    <StackPanel Grid.Row="0" Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="ARMING"
                                   FontSize="10" FontWeight="Bold" LetterSpacing="1"
                                   Foreground="{DynamicResource WarningBrush}"
                                   IsVisible="{Binding IsArming}"/>
                        <TextBlock Text="ACTIVE"
                                   FontSize="10" FontWeight="Bold" LetterSpacing="1"
                                   Foreground="{DynamicResource SuccessBrush}"
                                   IsVisible="{Binding !IsArming}"/>
                        <TextBlock Text="{Binding ArmSecondsRemaining, StringFormat='{}{0}s'}"
                                   FontSize="38" FontWeight="Bold"
                                   Foreground="{DynamicResource WarningBrush}"
                                   IsVisible="{Binding IsArming}"/>
                        <TextBlock Text="{Binding ClicksDelivered}"
                                   FontSize="38" FontWeight="Bold"
                                   Foreground="{DynamicResource SuccessBrush}"
                                   IsVisible="{Binding !IsArming}"/>
                    </StackPanel>

                    <StackPanel Classes="st-msg" VerticalAlignment="Center">
                        <TextBlock Text="{Binding StatusMessage}"
                                   FontSize="13"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   TextWrapping="Wrap"/>
                        <TextBlock Text="Move cursor to top-left corner to abort"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   Margin="0,4,0,0"
                                   TextWrapping="Wrap"
                                   IsVisible="{Binding FailsafeEnabled}"/>
                    </StackPanel>

                    <StackPanel Classes="st-elapsed" Grid.Row="0" VerticalAlignment="Center">
                        <TextBlock Text="ELAPSED"
                                   FontSize="9" FontWeight="Bold" LetterSpacing="1"
                                   Foreground="{DynamicResource TextMutedBrush}"/>
                        <TextBlock Text="{Binding ElapsedDisplay}"
                                   FontSize="20" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </StackPanel>

                    <Button Grid.Row="0" Grid.Column="3" Content="Stop" Classes="danger"
                            Padding="22,10"
                            VerticalAlignment="Center"
                            Command="{Binding StopCommand}"/>
                </Grid>
            </Border>

            <!-- ===== TARGET + INTERVAL ===== -->
            <Border Classes="card" Margin="0,0,0,10">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14" Spacing="8">
                        <Border Width="3" Height="14" CornerRadius="2"
                                Background="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="TARGET" FontSize="10" FontWeight="Bold" LetterSpacing="1"
                                   Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- X / Y and the capture buttons wrap onto further lines when there is no room -->
                    <WrapPanel Margin="0,0,0,6">
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,14,8">
                            <TextBlock Text="X" FontSize="12" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBox Text="{Binding ClickX, Mode=TwoWay, Converter={StaticResource FlexInt}}"
                                     Classes="input" Width="100"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,16,8">
                            <TextBlock Text="Y" FontSize="12" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBox Text="{Binding ClickY, Mode=TwoWay, Converter={StaticResource FlexInt}}"
                                     Classes="input" Width="100"/>
                        </StackPanel>
                        <Button Content="Use Cursor Now" Classes="secondary"
                                Padding="12,8" Margin="0,0,6,8"
                                ToolTip.Tip="Set X/Y to where your cursor is right now"
                                Command="{Binding GetCurrentPositionCommand}"/>
                        <Button Content="Capture in 3s" Classes="secondary"
                                Padding="12,8" Margin="0,0,0,8"
                                ToolTip.Tip="3-second countdown, then capture cursor position"
                                Command="{Binding CapturePositionCommand}"
                                IsEnabled="{Binding !IsCapturingPosition}"/>
                    </WrapPanel>

                    <!-- Mode selector -->
                    <TextBlock Text="MODE"
                               FontSize="10" FontWeight="Bold" LetterSpacing="0.5"
                               Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,6"/>
                    <ComboBox ItemsSource="{Binding ModeOptions}"
                              SelectedIndex="{Binding SelectedModeIndex, Mode=TwoWay}"
                              HorizontalAlignment="Stretch" Margin="0,0,0,14"/>

                    <!-- Mouse button + interval + arm delay + max clicks: 4 columns -> 2 -> 1 as the width shrinks -->
                    <controls:AdaptiveColumnsPanel MinColumnWidth="150" MaxColumns="4"
                                                   ColumnSpacing="12" RowSpacing="12">
                        <StackPanel>
                            <TextBlock Text="BUTTON" FontSize="10" FontWeight="Bold" LetterSpacing="0.5"
                                       Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,6"/>
                            <ComboBox ItemsSource="{Binding ButtonOptions}"
                                      SelectedIndex="{Binding SelectedButtonIndex, Mode=TwoWay}"
                                      HorizontalAlignment="Stretch"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="INTERVAL (s)" FontSize="10" FontWeight="Bold" LetterSpacing="0.5"
                                       Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,6"/>
                            <TextBox Text="{Binding IntervalSeconds, Mode=TwoWay, Converter={StaticResource FlexDouble}}"
                                     Classes="input"
                                     ToolTip.Tip="Seconds between clicks. Accepts 0.05 or 0,05 (50ms)"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="ARM DELAY (s)" FontSize="10" FontWeight="Bold" LetterSpacing="0.5"
                                       Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,6"/>
                            <TextBox Text="{Binding ArmDelaySeconds, Mode=TwoWay, Converter={StaticResource FlexDouble}}"
                                     Classes="input"
                                     ToolTip.Tip="Head-start countdown before clicking begins. Accepts 3 or 2.5"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="MAX CLICKS" FontSize="10" FontWeight="Bold" LetterSpacing="0.5"
                                       Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,6"/>
                            <TextBox Text="{Binding MaxClicks, Mode=TwoWay, Converter={StaticResource FlexInt}}"
                                     Classes="input"
                                     ToolTip.Tip="Stop after N clicks (0 = unlimited)"/>
                        </StackPanel>
                    </controls:AdaptiveColumnsPanel>
                </StackPanel>
            </Border>

            <!-- ===== ADVANCED ===== -->
            <Border Classes="card" Margin="0,0,0,10">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14" Spacing="8">
                        <Border Width="3" Height="14" CornerRadius="2"
                                Background="{DynamicResource InfoBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="ADVANCED" FontSize="10" FontWeight="Bold" LetterSpacing="1"
                                   Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <controls:AdaptiveColumnsPanel MinColumnWidth="260" MaxColumns="2"
                                                   ColumnSpacing="24" RowSpacing="12">
                        <StackPanel>
                            <TextBlock Text="JITTER (±px)" FontSize="10" FontWeight="Bold" LetterSpacing="0.5"
                                       Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,6"/>
                            <TextBox Text="{Binding JitterPixels, Mode=TwoWay, Converter={StaticResource FlexInt}}"
                                     Classes="input"
                                     ToolTip.Tip="Random ±N px offset around target — helps avoid detection"/>
                        </StackPanel>
                        <StackPanel VerticalAlignment="Bottom">
                            <CheckBox IsChecked="{Binding FailsafeEnabled, Mode=TwoWay}"
                                      ToolTip.Tip="Slam your mouse to the top-left corner to instantly stop the clicker">
                                <TextBlock Text="Failsafe — abort when cursor reaches top-left corner"
                                           FontSize="12" TextWrapping="Wrap"/>
                            </CheckBox>
                        </StackPanel>
                    </controls:AdaptiveColumnsPanel>
                </StackPanel>
            </Border>

            <!-- ===== ACTIONS ===== -->
            <Border Classes="card" Margin="0,0,0,10">
                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto">
                    <WrapPanel Grid.Row="0" Grid.Column="0" VerticalAlignment="Center">
                        <Button Content="Start" Classes="primary" Padding="36,10"
                                FontSize="14" Margin="0,0,10,0"
                                Command="{Binding StartCommand}"
                                IsEnabled="{Binding !IsRunning}"/>
                        <Button Content="Stop" Classes="secondary" Padding="28,10"
                                FontSize="14"
                                Command="{Binding StopCommand}"
                                IsEnabled="{Binding IsRunning}"/>
                    </WrapPanel>
                    <TextBlock Classes="act-status" VerticalAlignment="Center"
                               Text="{Binding StatusMessage}"
                               FontSize="12"
                               Foreground="{DynamicResource TextMutedBrush}"
                               TextWrapping="Wrap"
                               MaxLines="3"
                               TextTrimming="CharacterEllipsis"/>
                </Grid>
            </Border>

            <!-- ===== HOW IT WORKS ===== -->
            <Border Classes="card" Margin="0,0,0,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10" Spacing="8">
                        <Border Width="3" Height="14" CornerRadius="2"
                                Background="{DynamicResource SuccessBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="HOW IT WORKS" FontSize="10" FontWeight="Bold" LetterSpacing="1"
                                   Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="12" TextWrapping="Wrap">
                        <Run Text="Silent" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
                        <Run Text="sends click messages to the window under the target point — your cursor never moves. Best for most apps. "/>
                        <LineBreak/>
                        <Run Text="Teleport" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
                        <Run Text="actually moves the cursor and clicks — needed for games and apps that ignore synthetic messages. "/>
                        <LineBreak/>
                        <Run Text="Follow" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
                        <Run Text="clicks wherever your cursor is at each tick, never teleports."/>
                        <LineBreak/>
                        <LineBreak/>
                        <Run Text="Failsafe:" FontWeight="SemiBold" Foreground="{DynamicResource WarningBrush}"/>
                        <Run Text="if you ever lose control, slam the mouse to the top-left corner of your primary screen — the clicker stops immediately."/>
                    </TextBlock>
                </StackPanel>
            </Border>
        </StackPanel>
    </controls:PageHost>
</UserControl>
