<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewmodel="clr-namespace:CenterHubNew.MVVM.ViewModel"
             xmlns:models="clr-namespace:CenterHubNew.MVVM.Models"
             xmlns:conv="clr-namespace:CenterHubNew.MVVM.Converters"
             xmlns:controls="clr-namespace:CenterHubNew.MVVM.Controls"
             x:Class="CenterHubNew.MVVM.View.MetronomeView"
             x:DataType="viewmodel:MetronomeViewModel"
             mc:Ignorable="d"
             Background="Transparent">

    <UserControl.Resources>
        <conv:FlexibleIntConverter x:Key="FlexInt"/>
    </UserControl.Resources>

    <UserControl.Styles>
        <!-- Beat lights (accent / normal / muted, lit while sounding) -->
        <Style Selector="Border.light">
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="CornerRadius" Value="11"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Border.light.accent">
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}"/>
        </Style>
        <Style Selector="Border.light.muted">
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}"/>
            <Setter Property="Opacity" Value="0.45"/>
        </Style>
        <Style Selector="Border.light.active">
            <Setter Property="Background" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
        <Style Selector="Border.light.accent.active">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
        </Style>

        <!-- Pattern grid: playhead markers and cells -->
        <Style Selector="Border.marker">
            <Setter Property="Width" Value="14"/>
            <Setter Property="Height" Value="4"/>
            <Setter Property="CornerRadius" Value="2"/>
            <Setter Property="Margin" Value="0,0,3,0"/>
            <Setter Property="Background" Value="{DynamicResource BorderSubtleBrush}"/>
        </Style>
        <Style Selector="Border.marker.beat">
            <Setter Property="Margin" Value="6,0,3,0"/>
        </Style>
        <Style Selector="Border.marker.current">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
        </Style>

        <Style Selector="Border.cell">
            <Setter Property="Width" Value="14"/>
            <Setter Property="Height" Value="14"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Margin" Value="0,0,3,0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}"/>
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
        </Style>
        <Style Selector="Border.cell.beat">
            <Setter Property="Margin" Value="6,0,3,0"/>
        </Style>
        <Style Selector="Border.cell.hit">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
        </Style>

        <!-- Setlist rows (the active song is highlighted) -->
        <Style Selector="Border.song">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Border.song.active">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}"/>
        </Style>

        <!-- Practice log chart -->
        <Style Selector="Border.pbar">
            <Setter Property="CornerRadius" Value="3,3,1,1"/>
            <Setter Property="VerticalAlignment" Value="Bottom"/>
            <Setter Property="Background" Value="{DynamicResource InfoBrush}"/>
        </Style>
        <Style Selector="Border.pbar.today">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
        </Style>
        <Style Selector="Border.pbar.empty">
            <Setter Property="Background" Value="{DynamicResource BorderStrongBrush}"/>
            <Setter Property="Opacity" Value="0.5"/>
        </Style>

        <!-- ===== Responsive layout: StackPanel.root gets :narrow below 640 px of content width ===== -->

        <!-- Hero card: tempo left, beat circle + Start right; stacked when narrow -->
        <Style Selector="Grid.hero">
            <Setter Property="Margin" Value="32,28,32,24"/>
        </Style>
        <Style Selector="StackPanel.heroL">
            <Setter Property="Grid.Column" Value="0"/>
            <Setter Property="Grid.Row" Value="0"/>
        </Style>
        <Style Selector="StackPanel.heroR">
            <Setter Property="Grid.Column" Value="1"/>
            <Setter Property="Grid.Row" Value="0"/>
            <Setter Property="Margin" Value="32,0,0,0"/>
        </Style>
        <Style Selector="StackPanel.heroR > Button">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>
        <Style Selector="Border.modesw">
            <Setter Property="Padding" Value="32,14"/>
        </Style>
        <Style Selector="StackPanel.root:narrow Grid.hero">
            <Setter Property="Margin" Value="20,20,20,16"/>
        </Style>
        <Style Selector="StackPanel.root:narrow StackPanel.heroL">
            <Setter Property="Grid.ColumnSpan" Value="2"/>
        </Style>
        <Style Selector="StackPanel.root:narrow StackPanel.heroR">
            <Setter Property="Grid.Column" Value="0"/>
            <Setter Property="Grid.Row" Value="1"/>
            <Setter Property="Grid.ColumnSpan" Value="2"/>
            <Setter Property="Margin" Value="0,20,0,0"/>
        </Style>
        <Style Selector="StackPanel.root:narrow StackPanel.heroR > Button">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="MinWidth" Value="200"/>
        </Style>
        <Style Selector="StackPanel.root:narrow Border.modesw">
            <Setter Property="Padding" Value="20,12"/>
        </Style>

        <!-- Genre / style / kit: one row when wide; genre + kit on a row and style full width below when narrow -->
        <Style Selector="ComboBox.pickGenre">
            <Setter Property="Grid.Column" Value="0"/>
        </Style>
        <Style Selector="ComboBox.pickStyle">
            <Setter Property="Grid.Column" Value="2"/>
        </Style>
        <Style Selector="ComboBox.pickKit">
            <Setter Property="Grid.Column" Value="4"/>
        </Style>
        <Style Selector="StackPanel.root:narrow ComboBox.pickGenre">
            <Setter Property="Grid.ColumnSpan" Value="3"/>
        </Style>
        <Style Selector="StackPanel.root:narrow ComboBox.pickStyle">
            <Setter Property="Grid.Column" Value="0"/>
            <Setter Property="Grid.ColumnSpan" Value="5"/>
            <Setter Property="Grid.Row" Value="1"/>
            <Setter Property="Margin" Value="0,8,0,0"/>
        </Style>

        <!-- Pedal buttons 4 across / 2x2; click dropdowns 3 across / stacked; presets 6 / 3 across -->
        <Style Selector="controls|AdaptiveColumnsPanel.pedals">
            <Setter Property="MaxColumns" Value="4"/>
        </Style>
        <Style Selector="StackPanel.root:narrow controls|AdaptiveColumnsPanel.pedals">
            <Setter Property="MaxColumns" Value="2"/>
        </Style>
        <Style Selector="controls|AdaptiveColumnsPanel.clickpick">
            <Setter Property="MaxColumns" Value="3"/>
        </Style>
        <Style Selector="StackPanel.root:narrow controls|AdaptiveColumnsPanel.clickpick">
            <Setter Property="MaxColumns" Value="1"/>
        </Style>
        <Style Selector="controls|AdaptiveColumnsPanel.presets">
            <Setter Property="MaxColumns" Value="6"/>
        </Style>
        <Style Selector="StackPanel.root:narrow controls|AdaptiveColumnsPanel.presets">
            <Setter Property="MaxColumns" Value="3"/>
        </Style>

        <!-- Tap tempo + presets: side by side, stacked when narrow -->
        <Style Selector="Button.tap">
            <Setter Property="Grid.Column" Value="0"/>
            <Setter Property="Grid.Row" Value="0"/>
            <Setter Property="Padding" Value="22,12"/>
        </Style>
        <Style Selector="ItemsControl.presetList">
            <Setter Property="Grid.Column" Value="2"/>
            <Setter Property="Grid.Row" Value="0"/>
        </Style>
        <Style Selector="StackPanel.root:narrow Button.tap">
            <Setter Property="Grid.ColumnSpan" Value="3"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Padding" Value="22,10"/>
        </Style>
        <Style Selector="StackPanel.root:narrow ItemsControl.presetList">
            <Setter Property="Grid.Column" Value="0"/>
            <Setter Property="Grid.ColumnSpan" Value="3"/>
            <Setter Property="Grid.Row" Value="1"/>
        </Style>

        <!-- Setlist header: picker + New/Rename/Delete; picker on its own row when narrow -->
        <Style Selector="Panel.setPick">
            <Setter Property="Grid.Column" Value="0"/>
            <Setter Property="Grid.Row" Value="0"/>
        </Style>
        <Style Selector="StackPanel.root:narrow Panel.setPick">
            <Setter Property="Grid.ColumnSpan" Value="7"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style Selector="Button.setBtn">
            <Setter Property="Grid.Row" Value="0"/>
        </Style>
        <Style Selector="StackPanel.root:narrow Button.setBtn">
            <Setter Property="Grid.Row" Value="1"/>
        </Style>

        <!-- Setlist actions: add/update left, previous/next right; the second group drops below when narrow -->
        <Style Selector="WrapPanel.actR">
            <Setter Property="Grid.Column" Value="1"/>
            <Setter Property="Grid.Row" Value="0"/>
        </Style>
        <Style Selector="StackPanel.root:narrow WrapPanel.actR">
            <Setter Property="Grid.Column" Value="0"/>
            <Setter Property="Grid.ColumnSpan" Value="2"/>
            <Setter Property="Grid.Row" Value="1"/>
        </Style>
    </UserControl.Styles>

    <controls:PageHost Title="Metronome"
                       Subtitle="Click, drum beats with fills, and practice tools"
                       Mode="Reading">
        <controls:PageHost.HeaderBadge>
            <Border VerticalAlignment="Center"
                    CornerRadius="6" Padding="10,5"
                    Background="{DynamicResource SuccessBrush}"
                    IsVisible="{Binding IsPlaying}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Border Width="6" Height="6" CornerRadius="3"
                            Background="White" VerticalAlignment="Center"/>
                    <TextBlock Text="PLAYING" FontSize="10" FontWeight="Bold" LetterSpacing="1"
                               Foreground="White" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
        </controls:PageHost.HeaderBadge>

        <!-- Content root: gets :narrow below 640 px (see the responsive styles above) -->
        <StackPanel Classes="root" Spacing="0" controls:Responsive.NarrowBelow="640">

            <!-- ===== HERO CARD — tempo, beat lights, start/stop, mode switch ===== -->
            <Border Margin="0,0,0,12"
                    CornerRadius="14" Padding="0"
                    BorderThickness="1" BorderBrush="{DynamicResource BorderHairline}"
                    ClipToBounds="True" Background="{DynamicResource HeroBackgroundBrush}">
                <Grid RowDefinitions="4,Auto,Auto">
                    <Border Grid.Row="0" Background="{DynamicResource AccentBrush}"/>

                    <!-- Two columns when wide; the right column drops under the left one when narrow -->
                    <Grid Grid.Row="1" Classes="hero" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">

                        <!-- LEFT: tempo display + beat lights -->
                        <StackPanel Classes="heroL" VerticalAlignment="Center" Spacing="0">

                            <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,0,0,4">
                                <Border Width="10" Height="10" CornerRadius="5"
                                        Background="{DynamicResource AccentBrush}"
                                        VerticalAlignment="Center"/>
                                <TextBlock Text="TEMPO" FontSize="12" FontWeight="Bold" LetterSpacing="3"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Bottom">
                                <TextBlock Text="{Binding Bpm}"
                                           FontSize="92" FontWeight="Bold"
                                           LineHeight="100"
                                           FontFamily="Segoe UI Variable Display, Segoe UI, $default"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           VerticalAlignment="Bottom"/>
                                <TextBlock Text="BPM"
                                           FontSize="20" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           VerticalAlignment="Bottom"
                                           Margin="0,0,0,12"/>
                            </StackPanel>

                            <WrapPanel Orientation="Horizontal" Margin="0,2,0,16">
                                <TextBlock Text="{Binding TempoName}"
                                           FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBlock Text="·" FontSize="12" Margin="6,0,0,0"
                                           Foreground="{DynamicResource TextMutedBrush}"/>
                                <TextBlock Text="{Binding IntervalDisplay}"
                                           FontSize="11" Margin="6,0,0,0"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           VerticalAlignment="Center"/>
                            </WrapPanel>

                            <!-- Beat lights: click one to cycle accent -> normal -> mute -->
                            <ItemsControl ItemsSource="{Binding BeatLights}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="viewmodel:BeatLight">
                                        <Button Classes="ghost" Padding="3" Cursor="Hand" Margin="0,0,5,5"
                                                Command="{Binding $parent[ItemsControl].((viewmodel:MetronomeViewModel)DataContext).CycleAccentCommand}"
                                                CommandParameter="{Binding}"
                                                ToolTip.Tip="Click to change: accent → normal → mute">
                                            <Border Classes="light"
                                                    Classes.accent="{Binding IsAccent}"
                                                    Classes.muted="{Binding IsMuted}"
                                                    Classes.active="{Binding IsActive}"/>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="Click a beat to accent or mute it"
                                       FontSize="10" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       Margin="3,0,0,0"/>

                        </StackPanel>

                        <!-- RIGHT: current beat + play/stop -->
                        <StackPanel Classes="heroR" Spacing="14" VerticalAlignment="Center">

                            <Border Width="120" Height="120" CornerRadius="60"
                                    HorizontalAlignment="Center"
                                    BorderThickness="3"
                                    BorderBrush="{DynamicResource AccentBrush}"
                                    Background="{DynamicResource AccentSubtleBrush}">
                                <TextBlock Text="{Binding CurrentBeat}"
                                           FontSize="60" FontWeight="Bold"
                                           FontFamily="Segoe UI Variable Display, Segoe UI, $default"
                                           Foreground="{DynamicResource AccentBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <Button Classes="primary" Padding="36,11" FontSize="14"
                                    HorizontalContentAlignment="Center"
                                    Command="{Binding TogglePlayCommand}">
                                <Panel>
                                    <TextBlock Text="Stop" FontWeight="SemiBold"
                                               IsVisible="{Binding IsPlaying}"/>
                                    <TextBlock Text="Start" FontWeight="SemiBold"
                                               IsVisible="{Binding !IsPlaying}"/>
                                </Panel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- MODE SWITCH -->
                    <Border Grid.Row="2" Classes="modesw"
                            BorderThickness="0,1,0,0"
                            BorderBrush="{DynamicResource BorderHairline}">
                        <Grid ColumnDefinitions="*,8,*">
                            <Button Grid.Column="0"
                                    Classes.primary="{Binding IsClickMode}"
                                    Classes.secondary="{Binding IsDrumsMode}"
                                    HorizontalAlignment="Stretch"
                                    Padding="16,9"
                                    Command="{Binding ShowClickModeCommand}">
                                <TextBlock Text="Click" FontWeight="SemiBold"/>
                            </Button>
                            <Button Grid.Column="2"
                                    Classes.primary="{Binding IsDrumsMode}"
                                    Classes.secondary="{Binding IsClickMode}"
                                    HorizontalAlignment="Stretch"
                                    Padding="16,9"
                                    Command="{Binding ShowDrumsModeCommand}">
                                <TextBlock Text="Drum beats" FontWeight="SemiBold"/>
                            </Button>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- ===== DRUM BEAT ===== -->
            <Border Classes="card" Margin="0,0,0,12" IsVisible="{Binding IsDrumsMode}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14" Spacing="8">
                        <Border Width="3" Height="14" CornerRadius="2"
                                Background="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="DRUM BEAT" FontSize="10" FontWeight="Bold" LetterSpacing="1"
                                   Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Genre / style / kit (the style box goes full width on its own row when narrow) -->
                    <Grid ColumnDefinitions="150,8,*,8,140" RowDefinitions="Auto,Auto" Margin="0,0,0,12">
                        <ComboBox Classes="pickGenre"
                                  ItemsSource="{Binding Genres}"
                                  SelectedItem="{Binding SelectedGenre, Mode=TwoWay}"
                                  HorizontalAlignment="Stretch"/>
                        <ComboBox Classes="pickStyle"
                                  ItemsSource="{Binding FilteredStyles}"
                                  SelectedItem="{Binding SelectedStyle, Mode=TwoWay}"
                                  HorizontalAlignment="Stretch">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="models:DrumStyle">
                                    <!-- One line, so the closed box is as tall as its neighbours -->
                                    <Grid ColumnDefinitions="Auto,10,*">
                                        <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="13"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Description}" FontSize="11"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource TextMutedBrush}"/>
                                    </Grid>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <ComboBox Classes="pickKit"
                                  ItemsSource="{Binding KitChoices}"
                                  SelectedItem="{Binding SelectedKit, Mode=TwoWay}"
                                  HorizontalAlignment="Stretch"/>
                    </Grid>

                    <!-- Status line -->
                    <WrapPanel Orientation="Horizontal" MinHeight="24" Margin="0,0,0,12">
                        <Border VerticalAlignment="Center" CornerRadius="6" Padding="10,3" Margin="0,0,10,0"
                                Background="{DynamicResource AccentSubtleBrush}"
                                IsVisible="{Binding IsPlaying}">
                            <TextBlock Text="{Binding SectionLabel}"
                                       FontSize="10" FontWeight="Bold" LetterSpacing="1"
                                       Foreground="{DynamicResource AccentBrush}"/>
                        </Border>
                        <TextBlock Text="{Binding BarNumber, StringFormat='Bar {0}'}"
                                   FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   IsVisible="{Binding HasBar}"/>
                        <Border VerticalAlignment="Center" CornerRadius="6" Padding="8,3"
                                Background="{DynamicResource WarningSubtleBrush}"
                                IsVisible="{Binding IsGapMuted}">
                            <TextBlock Text="MUTED"
                                       FontSize="10" FontWeight="Bold" LetterSpacing="1"
                                       Foreground="{DynamicResource WarningBrush}"/>
                        </Border>
                    </WrapPanel>

                    <!-- Pedal row: 4 across, 2x2 when narrow -->
                    <controls:AdaptiveColumnsPanel Classes="pedals" MinColumnWidth="120"
                                                   ColumnSpacing="8" RowSpacing="8" Margin="0,0,0,12">
                        <Button Classes="secondary" Padding="10,14"
                                HorizontalAlignment="Stretch"
                                IsEnabled="{Binding IsPlaying}"
                                Command="{Binding FillCommand}">
                            <StackPanel Spacing="2">
                                <TextBlock Text="Fill" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                <TextBlock Text="Play a fill" FontSize="10" HorizontalAlignment="Center"
                                           Foreground="{DynamicResource TextMutedBrush}"/>
                            </StackPanel>
                        </Button>
                        <Button Classes="secondary" Padding="10,14"
                                HorizontalAlignment="Stretch"
                                IsEnabled="{Binding CanNextPart}"
                                Command="{Binding NextPartCommand}">
                            <StackPanel Spacing="2">
                                <TextBlock Text="Next part" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding NextPartName, StringFormat='→ {0}'}"
                                           FontSize="10" HorizontalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           IsVisible="{Binding HasMultipleParts}"/>
                                <TextBlock Text="Single part"
                                           FontSize="10" HorizontalAlignment="Center"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           IsVisible="{Binding !HasMultipleParts}"/>
                            </StackPanel>
                        </Button>
                        <Button Classes="secondary" Padding="10,14"
                                HorizontalAlignment="Stretch"
                                Command="{Binding AccentHitCommand}">
                            <StackPanel Spacing="2">
                                <TextBlock Text="Accent hit" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                <TextBlock Text="Crash!" FontSize="10" HorizontalAlignment="Center"
                                           Foreground="{DynamicResource TextMutedBrush}"/>
                            </StackPanel>
                        </Button>
                        <Button Classes="secondary" Padding="10,14"
                                HorizontalAlignment="Stretch"
                                IsEnabled="{Binding IsPlaying}"
                                Command="{Binding OutroCommand}">
                            <StackPanel Spacing="2">
                                <TextBlock Text="Outro" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                <TextBlock Text="Ending fill, then stop" FontSize="10" HorizontalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource TextMutedBrush}"/>
                            </StackPanel>
                        </Button>
                    </controls:AdaptiveColumnsPanel>

                    <!-- Pattern grid (wide content: scrolls sideways on its own) -->
                    <Border Classes="card-inner" Margin="0,0,0,14" IsVisible="{Binding HasPattern}">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Disabled">
                            <StackPanel Margin="0,0,0,6">
                                <ItemsControl ItemsSource="{Binding StepMarkers}" Margin="64,0,0,6">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="viewmodel:StepMarker">
                                            <Border Classes="marker"
                                                    Width="{Binding Width}"
                                                    Classes.beat="{Binding IsBeatStart}"
                                                    Classes.current="{Binding IsCurrent}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <ItemsControl ItemsSource="{Binding PatternRows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="viewmodel:PatternRow">
                                            <Grid ColumnDefinitions="64,Auto" Margin="0,0,0,3">
                                                <TextBlock Grid.Column="0" Text="{Binding Label}"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource TextMutedBrush}"
                                                           VerticalAlignment="Center"/>
                                                <ItemsControl Grid.Column="1" ItemsSource="{Binding Cells}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <StackPanel Orientation="Horizontal"/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="viewmodel:PatternCell">
                                                            <Border Classes="cell"
                                                                    Width="{Binding Width}"
                                                                    Classes.beat="{Binding IsBeatStart}"
                                                                    Classes.hit="{Binding IsHit}"
                                                                    Opacity="{Binding CellOpacity}"/>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <!-- Options -->
                    <WrapPanel Orientation="Horizontal">
                        <CheckBox Content="Count-in" IsChecked="{Binding CountIn, Mode=TwoWay}"
                                  FontSize="12" Margin="0,0,18,0" VerticalAlignment="Center"/>
                        <CheckBox Content="Intro fill" IsChecked="{Binding IntroFill, Mode=TwoWay}"
                                  FontSize="12" Margin="0,0,18,0" VerticalAlignment="Center"/>
                        <CheckBox Content="Click on top" IsChecked="{Binding ClickWithDrums, Mode=TwoWay}"
                                  FontSize="12" Margin="0,0,18,0" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock Text="Auto-fill" FontSize="12"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       VerticalAlignment="Center"/>
                            <ComboBox ItemsSource="{Binding AutoFillChoices}"
                                      SelectedItem="{Binding SelectedAutoFill, Mode=TwoWay}"
                                      Width="150"/>
                        </StackPanel>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- ===== TEMPO ===== -->
            <Border Classes="card" Margin="0,0,0,12">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14" Spacing="8">
                        <Border Width="3" Height="14" CornerRadius="2"
                                Background="{DynamicResource InfoBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="TEMPO" FontSize="10" FontWeight="Bold" LetterSpacing="1"
                                   Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- −5 − [slider] + +5 [bpm]: only the slider is flexible, so it shrinks on a narrow page -->
                    <Grid ColumnDefinitions="Auto,6,Auto,*,Auto,6,Auto,Auto" Margin="0,0,0,14">
                        <Button Grid.Column="0" Classes="secondary"
                                Padding="12,9" FontSize="13" FontWeight="Bold"
                                Content="−5"
                                ToolTip.Tip="Decrease BPM by 5"
                                Command="{Binding BpmDownFiveCommand}"/>
                        <Button Grid.Column="2" Classes="secondary"
                                Padding="14,9" FontSize="14" FontWeight="Bold"
                                Content="−"
                                ToolTip.Tip="Decrease BPM by 1"
                                Command="{Binding BpmDecreaseCommand}"/>
                        <Slider Grid.Column="3"
                                Minimum="30" Maximum="280"
                                Value="{Binding Bpm, Mode=TwoWay}"
                                VerticalAlignment="Center"
                                Margin="10,0,10,0"
                                TickFrequency="10"/>
                        <Button Grid.Column="4" Classes="secondary"
                                Padding="14,9" FontSize="14" FontWeight="Bold"
                                Content="+"
                                ToolTip.Tip="Increase BPM by 1"
                                Command="{Binding BpmIncreaseCommand}"/>
                        <Button Grid.Column="6" Classes="secondary"
                                Padding="12,9" FontSize="13" FontWeight="Bold"
                                Content="+5"
                                ToolTip.Tip="Increase BPM by 5"
                                Command="{Binding BpmUpFiveCommand}"/>
                        <TextBox Grid.Column="7"
                                 Text="{Binding Bpm, Mode=TwoWay, Converter={StaticResource FlexInt}}"
                                 Classes="input" Width="70"
                                 FontSize="15" FontWeight="SemiBold"
                                 Margin="10,0,0,0"/>
                    </Grid>

                    <!-- Volume row -->
                    <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,14">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6"
                                    VerticalAlignment="Center" Width="90">
                            <TextBlock Text="&#xE767;" FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets"
                                       FontSize="14" Foreground="{DynamicResource TextMutedBrush}"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="VOLUME" FontSize="9" FontWeight="Bold" LetterSpacing="1"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <Slider Grid.Column="1"
                                Minimum="0" Maximum="1"
                                Value="{Binding Volume, Mode=TwoWay}"
                                VerticalAlignment="Center"
                                Margin="10,0,10,0"/>
                        <TextBlock Grid.Column="2"
                                   Text="{Binding Volume, StringFormat={}{0:P0}}"
                                   FontSize="12" FontWeight="SemiBold" Width="42"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   VerticalAlignment="Center" TextAlignment="Right"/>
                    </Grid>

                    <!-- Tap tempo + presets (stacked when narrow) -->
                    <Grid ColumnDefinitions="Auto,12,*" RowDefinitions="Auto,Auto">
                        <Button Classes="secondary tap"
                                FontSize="13"
                                VerticalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                Command="{Binding TapTempoCommand}"
                                ToolTip.Tip="Click in rhythm at least twice to set the BPM">
                            <TextBlock Text="Tap tempo" FontWeight="SemiBold"/>
                        </Button>
                        <ItemsControl Classes="presetList" ItemsSource="{Binding Presets}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <controls:AdaptiveColumnsPanel Classes="presets" MinColumnWidth="64"
                                                                   ColumnSpacing="6" RowSpacing="6"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="viewmodel:MetronomePreset">
                                    <Button Classes="secondary" Padding="4,8"
                                            HorizontalAlignment="Stretch"
                                            ToolTip.Tip="{Binding Italian}"
                                            Command="{Binding $parent[ItemsControl].((viewmodel:MetronomeViewModel)DataContext).ApplyPresetCommand}"
                                            CommandParameter="{Binding}">
                                        <StackPanel Spacing="1">
                                            <TextBlock Text="{Binding Name}" FontSize="11"
                                                       HorizontalAlignment="Center"
                                                       Foreground="{DynamicResource TextMutedBrush}"/>
                                            <TextBlock Text="{Binding Bpm}" FontSize="15" FontWeight="Bold"
                                                       HorizontalAlignment="Center"
                                                       Foreground="{DynamicResource AccentBrush}"/>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ===== CLICK ===== -->
            <Border Classes="card" Margin="0,0,0,12" IsVisible="{Binding IsClickMode}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14" Spacing="8">
                        <Border Width="3" Height="14" CornerRadius="2"
                                Background="{DynamicResource SuccessBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="CLICK" FontSize="10" FontWeight="Bold" LetterSpacing="1"
                                   Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Three dropdowns across; stacked when narrow -->
                    <controls:AdaptiveColumnsPanel Classes="clickpick" MinColumnWidth="150"
                                                   ColumnSpacing="12" RowSpacing="12">
                        <StackPanel>
                            <TextBlock Text="SOUND"
                                       FontSize="9" FontWeight="Bold" LetterSpacing="1"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       Margin="0,0,0,6"/>
                            <ComboBox ItemsSource="{Binding SoundChoices}"
                                      SelectedItem="{Binding SelectedSound, Mode=TwoWay}"
                                      HorizontalAlignment="Stretch"
                                      ToolTip.Tip="Pick the click timbre — selecting one previews it"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="BEATS PER BAR"
                                       FontSize="9" FontWeight="Bold" LetterSpacing="1"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       Margin="0,0,0,6"/>
                            <ComboBox ItemsSource="{Binding BeatChoices}"
                                      SelectedItem="{Binding BeatsPerMeasure, Mode=TwoWay}"
                                      HorizontalAlignment="Stretch"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="SUBDIVISION"
                                       FontSize="9" FontWeight="Bold" LetterSpacing="1"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       Margin="0,0,0,6"/>
                            <ComboBox ItemsSource="{Binding SubdivisionChoices}"
                                      SelectedItem="{Binding SelectedSubdivision, Mode=TwoWay}"
                                      HorizontalAlignment="Stretch"/>
                        </StackPanel>
                    </controls:AdaptiveColumnsPanel>
                </StackPanel>
            </Border>

            <!-- ===== SETLIST ===== -->
            <Border Classes="card" Margin="0,0,0,12">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14" Spacing="8">
                        <Border Width="3" Height="14" CornerRadius="2"
                                Background="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="SETLIST" FontSize="10" FontWeight="Bold" LetterSpacing="1"
                                   Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Setlist picker (or its name while renaming) + New / Rename / Delete.
                         When narrow the picker takes the first row and the buttons the second. -->
                    <Grid ColumnDefinitions="*,8,Auto,6,Auto,6,Auto" RowDefinitions="Auto,Auto" Margin="0,0,0,12">
                        <Panel Classes="setPick">
                            <ComboBox ItemsSource="{Binding Setlists}"
                                      SelectedItem="{Binding SelectedSetlist, Mode=TwoWay}"
                                      PlaceholderText="No setlist yet"
                                      HorizontalAlignment="Stretch"
                                      IsVisible="{Binding !IsRenamingSetlist}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="viewmodel:SetlistItem">
                                        <TextBlock Text="{Binding Name}" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBox Classes="input"
                                     Text="{Binding SelectedSetlist.Name, Mode=TwoWay}"
                                     Watermark="Setlist name"
                                     IsVisible="{Binding IsRenamingSetlist}">
                                <TextBox.KeyBindings>
                                    <KeyBinding Gesture="Enter" Command="{Binding RenameSetlistCommand}"/>
                                </TextBox.KeyBindings>
                            </TextBox>
                        </Panel>
                        <Button Grid.Column="2" Classes="secondary setBtn" Padding="14,8" FontSize="12"
                                Command="{Binding NewSetlistCommand}"
                                ToolTip.Tip="Create a new setlist">
                            <TextBlock Text="New" FontWeight="SemiBold"/>
                        </Button>
                        <Button Grid.Column="4" Classes="secondary setBtn" Padding="14,8" FontSize="12"
                                IsEnabled="{Binding HasSelectedSetlist}"
                                Command="{Binding RenameSetlistCommand}"
                                ToolTip.Tip="Rename the setlist (Enter to finish)">
                            <Panel>
                                <TextBlock Text="Rename" FontWeight="SemiBold" IsVisible="{Binding !IsRenamingSetlist}"/>
                                <TextBlock Text="Done" FontWeight="SemiBold" IsVisible="{Binding IsRenamingSetlist}"/>
                            </Panel>
                        </Button>
                        <Button Grid.Column="6" Classes="danger setBtn" Padding="14,8" FontSize="12"
                                IsEnabled="{Binding HasSelectedSetlist}"
                                Command="{Binding DeleteSetlistCommand}"
                                ToolTip.Tip="Delete the whole setlist">
                            <TextBlock Text="Delete" FontWeight="SemiBold"/>
                        </Button>
                    </Grid>

                    <!-- Songs -->
                    <Border Classes="card-inner" Padding="8" Margin="0,0,0,12">
                        <Panel>
                            <TextBlock Text="Save the current tempo and beat as a song to build a setlist."
                                       FontSize="12" TextWrapping="Wrap" Margin="6,8"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       IsVisible="{Binding !HasSongs}"/>
                            <ScrollViewer MaxHeight="300"
                                          HorizontalScrollBarVisibility="Disabled"
                                          VerticalScrollBarVisibility="Auto"
                                          IsVisible="{Binding HasSongs}">
                                <ItemsControl ItemsSource="{Binding Songs}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="viewmodel:SetlistSongItem">
                                            <Border Classes="song" Classes.active="{Binding IsActive}">
                                                <Grid ColumnDefinitions="Auto,10,*,8,Auto,2,Auto,2,Auto">
                                                    <Button Grid.Column="0" Classes="secondary"
                                                            Width="36" Height="36" Padding="0"
                                                            VerticalAlignment="Center"
                                                            Command="{Binding $parent[ItemsControl].((viewmodel:MetronomeViewModel)DataContext).LoadSongCommand}"
                                                            CommandParameter="{Binding Song}"
                                                            ToolTip.Tip="Load this song">
                                                        <TextBlock Text="{Binding Number}" FontWeight="Bold" FontSize="13"/>
                                                    </Button>
                                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="1">
                                                        <TextBox Classes="input" Padding="6,3" FontSize="13" FontWeight="SemiBold"
                                                                 Text="{Binding Name, Mode=TwoWay}"
                                                                 Watermark="Song name"/>
                                                        <TextBlock Text="{Binding Description}" FontSize="11" Margin="7,2,0,0"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Foreground="{DynamicResource TextMutedBrush}"/>
                                                    </StackPanel>
                                                    <Button Grid.Column="4" Classes="ghost" Padding="8,6" FontSize="11"
                                                            VerticalAlignment="Center"
                                                            Command="{Binding $parent[ItemsControl].((viewmodel:MetronomeViewModel)DataContext).MoveSongUpCommand}"
                                                            CommandParameter="{Binding}"
                                                            ToolTip.Tip="Move up">
                                                        <TextBlock Text="▲"/>
                                                    </Button>
                                                    <Button Grid.Column="6" Classes="ghost" Padding="8,6" FontSize="11"
                                                            VerticalAlignment="Center"
                                                            Command="{Binding $parent[ItemsControl].((viewmodel:MetronomeViewModel)DataContext).MoveSongDownCommand}"
                                                            CommandParameter="{Binding}"
                                                            ToolTip.Tip="Move down">
                                                        <TextBlock Text="▼"/>
                                                    </Button>
                                                    <Button Grid.Column="8" Classes="ghost" Padding="8,6" FontSize="11"
                                                            VerticalAlignment="Center"
                                                            Command="{Binding $parent[ItemsControl].((viewmodel:MetronomeViewModel)DataContext).RemoveSongCommand}"
                                                            CommandParameter="{Binding}"
                                                            ToolTip.Tip="Remove from the setlist">
                                                        <TextBlock Text="✕"/>
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Panel>
                    </Border>

                    <!-- Actions: add/update on the left, previous/next on the right; both groups wrap -->
                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                        <WrapPanel Grid.Column="0" Orientation="Horizontal">
                            <Button Classes="primary" Padding="16,9" FontSize="12" Margin="0,0,8,8"
                                    Command="{Binding AddCurrentAsSongCommand}"
                                    ToolTip.Tip="Save the current tempo, beat and options as a new song">
                                <TextBlock Text="Add current settings" FontWeight="SemiBold"/>
                            </Button>
                            <Button Classes="secondary" Padding="16,9" FontSize="12" Margin="0,0,8,8"
                                    IsEnabled="{Binding HasSelectedSong}"
                                    Command="{Binding UpdateSongFromCurrentCommand}"
                                    ToolTip.Tip="Overwrite the highlighted song with the current settings">
                                <TextBlock Text="Update song" FontWeight="SemiBold"/>
                            </Button>
                        </WrapPanel>
                        <WrapPanel Classes="actR" Orientation="Horizontal">
                            <Button Classes="secondary" Padding="16,9" FontSize="12" Margin="0,0,8,8"
                                    IsEnabled="{Binding HasSongs}"
                                    Command="{Binding PreviousSongCommand}">
                                <TextBlock Text="◀ Previous" FontWeight="SemiBold"/>
                            </Button>
                            <Button Classes="secondary" Padding="16,9" FontSize="12" Margin="0,0,0,8"
                                    IsEnabled="{Binding HasSongs}"
                                    Command="{Binding NextSongCommand}">
                                <TextBlock Text="Next ▶" FontWeight="SemiBold"/>
                            </Button>
                        </WrapPanel>
                    </Grid>
                    <TextBlock Text="Click a song's number to load it. Playback keeps going when you switch songs."
                               FontSize="10" Margin="2,0,0,0" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextMutedBrush}"
                               IsVisible="{Binding HasSongs}"/>
                </StackPanel>
            </Border>

            <!-- ===== PRACTICE TOOLS ===== -->
            <Border Classes="card" Margin="0,0,0,12">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14" Spacing="8">
                        <Border Width="3" Height="14" CornerRadius="2"
                                Background="{DynamicResource WarningBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="PRACTICE TOOLS" FontSize="10" FontWeight="Bold" LetterSpacing="1"
                                   Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Speed trainer / Gap trainer: side by side, stacked when narrow -->
                    <controls:AdaptiveColumnsPanel MinColumnWidth="280" MaxColumns="2"
                                                   ColumnSpacing="12" RowSpacing="12">
                        <!-- Speed trainer -->
                        <Border Classes="card-inner">
                            <StackPanel>
                                <TextBlock Text="SPEED TRAINER"
                                           FontSize="9" FontWeight="Bold" LetterSpacing="1"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           Margin="0,0,0,8"/>
                                <CheckBox Content="Speed up as I play"
                                          IsChecked="{Binding TrainerEnabled, Mode=TwoWay}"
                                          FontSize="12" Margin="0,0,0,8"/>
                                <Grid ColumnDefinitions="78,110,*" RowDefinitions="Auto,Auto,Auto">
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Add" FontSize="12" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <NumericUpDown Grid.Row="0" Grid.Column="1" Minimum="1" Maximum="50" Increment="1"
                                                   FormatString="0" Margin="0,3"
                                                   Value="{Binding TrainerStepBpm, Mode=TwoWay}"/>
                                    <TextBlock Grid.Row="0" Grid.Column="2" Text="BPM" FontSize="12" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="8,0,0,0"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="every" FontSize="12" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <NumericUpDown Grid.Row="1" Grid.Column="1" Minimum="1" Maximum="64" Increment="1"
                                                   FormatString="0" Margin="0,3"
                                                   Value="{Binding TrainerEveryBars, Mode=TwoWay}"/>
                                    <TextBlock Grid.Row="1" Grid.Column="2" Text="bars" FontSize="12" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="8,0,0,0"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="up to" FontSize="12" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <NumericUpDown Grid.Row="2" Grid.Column="1" Minimum="30" Maximum="280" Increment="1"
                                                   FormatString="0" Margin="0,3"
                                                   Value="{Binding TrainerTargetBpm, Mode=TwoWay}"/>
                                    <TextBlock Grid.Row="2" Grid.Column="2" Text="BPM" FontSize="12" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="8,0,0,0"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Gap trainer -->
                        <Border Classes="card-inner">
                            <StackPanel>
                                <TextBlock Text="GAP TRAINER"
                                           FontSize="9" FontWeight="Bold" LetterSpacing="1"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           Margin="0,0,0,8"/>
                                <CheckBox Content="Drop out to test my timing"
                                          IsChecked="{Binding GapEnabled, Mode=TwoWay}"
                                          FontSize="12" Margin="0,0,0,8"/>
                                <Grid ColumnDefinitions="78,110,*" RowDefinitions="Auto,Auto">
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Play" FontSize="12" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <NumericUpDown Grid.Row="0" Grid.Column="1" Minimum="1" Maximum="16" Increment="1"
                                                   FormatString="0" Margin="0,3"
                                                   Value="{Binding GapPlayBars, Mode=TwoWay}"/>
                                    <TextBlock Grid.Row="0" Grid.Column="2" Text="bars" FontSize="12" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="8,0,0,0"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="then silent" FontSize="12" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <NumericUpDown Grid.Row="1" Grid.Column="1" Minimum="1" Maximum="16" Increment="1"
                                                   FormatString="0" Margin="0,3"
                                                   Value="{Binding GapMuteBars, Mode=TwoWay}"/>
                                    <TextBlock Grid.Row="1" Grid.Column="2" Text="bars" FontSize="12" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="8,0,0,0"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </controls:AdaptiveColumnsPanel>
                </StackPanel>
            </Border>

            <!-- ===== PRACTICE LOG ===== -->
            <Border Classes="card" Margin="0,0,0,12" IsVisible="{Binding HasPracticeLog}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14" Spacing="8">
                        <Border Width="3" Height="14" CornerRadius="2"
                                Background="{DynamicResource SuccessBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="PRACTICE LOG" FontSize="10" FontWeight="Bold" LetterSpacing="1"
                                   Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Four stats across; 2x2 when narrow -->
                    <controls:AdaptiveColumnsPanel MinColumnWidth="130" MaxColumns="4"
                                                   ColumnSpacing="12" RowSpacing="12" Margin="0,0,0,16">
                        <StackPanel Spacing="2">
                            <TextBlock Text="TODAY" FontSize="9" FontWeight="Bold" LetterSpacing="1"
                                       Foreground="{DynamicResource TextMutedBrush}"/>
                            <TextBlock Text="{Binding TodayText}" FontSize="18" FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </StackPanel>
                        <StackPanel Spacing="2">
                            <TextBlock Text="THIS WEEK" FontSize="9" FontWeight="Bold" LetterSpacing="1"
                                       Foreground="{DynamicResource TextMutedBrush}"/>
                            <TextBlock Text="{Binding WeekText}" FontSize="18" FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </StackPanel>
                        <StackPanel Spacing="2">
                            <TextBlock Text="STREAK" FontSize="9" FontWeight="Bold" LetterSpacing="1"
                                       Foreground="{DynamicResource TextMutedBrush}"/>
                            <TextBlock Text="{Binding StreakText}" FontSize="18" FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </StackPanel>
                        <StackPanel Spacing="2">
                            <TextBlock Text="BEST TEMPO (30 DAYS)" FontSize="9" FontWeight="Bold" LetterSpacing="1"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextMutedBrush}"/>
                            <TextBlock Text="{Binding BestBpmText}" FontSize="18" FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </StackPanel>
                    </controls:AdaptiveColumnsPanel>

                    <TextBlock Text="LAST 14 DAYS" FontSize="9" FontWeight="Bold" LetterSpacing="1"
                               Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,8"/>
                    <!-- 14 bars are ~450 px wide: scrolls sideways when the page is narrower -->
                    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding PracticeBars}" HorizontalAlignment="Left">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="viewmodel:PracticeBar">
                                    <!-- Transparent full-height column so even an empty day has a hover target -->
                                    <Border Background="Transparent" Width="26" Height="56" Margin="0,0,6,0"
                                            ToolTip.Tip="{Binding Tooltip}">
                                        <Border Classes="pbar"
                                                Classes.today="{Binding IsToday}"
                                                Classes.empty="{Binding !HasPractice}"
                                                Height="{Binding Height}"/>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </Border>

        </StackPanel>
    </controls:PageHost>
</UserControl>
