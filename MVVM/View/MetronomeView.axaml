<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewmodel="clr-namespace:CenterHubNew.MVVM.ViewModel"
             xmlns:models="clr-namespace:CenterHubNew.MVVM.Models"
             xmlns:conv="clr-namespace:CenterHubNew.MVVM.Converters"
             x:Class="CenterHubNew.MVVM.View.MetronomeView"
             x:DataType="viewmodel:MetronomeViewModel"
             mc:Ignorable="d"
             Background="Transparent">

    <UserControl.Resources>
        <conv:FlexibleIntConverter x:Key="FlexInt"/>
    </UserControl.Resources>

    <UserControl.Styles>
        <!-- Beat lights (accent / normal / muted, lit while sounding) -->
        <Style Selector="Border.light">
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="CornerRadius" Value="11"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Border.light.accent">
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Background" Value="{StaticResource AccentSubtleBrush}"/>
        </Style>
        <Style Selector="Border.light.muted">
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}"/>
            <Setter Property="Opacity" Value="0.45"/>
        </Style>
        <Style Selector="Border.light.active">
            <Setter Property="Background" Value="{StaticResource TextPrimaryBrush}"/>
        </Style>
        <Style Selector="Border.light.accent.active">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
        </Style>

        <!-- Pattern grid: playhead markers and cells -->
        <Style Selector="Border.marker">
            <Setter Property="Width" Value="14"/>
            <Setter Property="Height" Value="4"/>
            <Setter Property="CornerRadius" Value="2"/>
            <Setter Property="Margin" Value="0,0,3,0"/>
            <Setter Property="Background" Value="{StaticResource BorderSubtleBrush}"/>
        </Style>
        <Style Selector="Border.marker.beat">
            <Setter Property="Margin" Value="6,0,3,0"/>
        </Style>
        <Style Selector="Border.marker.current">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
        </Style>

        <Style Selector="Border.cell">
            <Setter Property="Width" Value="14"/>
            <Setter Property="Height" Value="14"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Margin" Value="0,0,3,0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}"/>
            <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}"/>
        </Style>
        <Style Selector="Border.cell.beat">
            <Setter Property="Margin" Value="6,0,3,0"/>
        </Style>
        <Style Selector="Border.cell.hit">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
        </Style>
    </UserControl.Styles>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Padding="24,20" Background="Transparent">
        <!-- Soft fade at the bottom edge so scrollable content tapers off
             gracefully instead of looking hard-clipped at the viewport edge.
             The trailing spacer below is sized to exceed the fade zone, so the
             last real card is never dimmed at max scroll. -->
        <ScrollViewer.OpacityMask>
            <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                <GradientStop Offset="0.0"  Color="White"/>
                <GradientStop Offset="0.95" Color="White"/>
                <GradientStop Offset="1.0"  Color="Transparent"/>
            </LinearGradientBrush>
        </ScrollViewer.OpacityMask>
        <!-- Stretch (not Center): the page keeps one width whatever the pattern grid needs -->
        <Border MaxWidth="900" HorizontalAlignment="Stretch">
        <StackPanel Spacing="0">

            <!-- ===== PAGE HEADER ===== -->
            <Grid Margin="0,0,0,20" ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Metronome"
                               FontSize="22" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="Click, drum beats with fills, and practice tools"
                               FontSize="12"
                               Foreground="{StaticResource TextMutedBrush}"
                               Margin="0,2,0,0"/>
                </StackPanel>
                <Border Grid.Column="1" VerticalAlignment="Center"
                        CornerRadius="6" Padding="10,5"
                        Background="{StaticResource SuccessBrush}"
                        IsVisible="{Binding IsPlaying}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Border Width="6" Height="6" CornerRadius="3"
                                Background="White" VerticalAlignment="Center"/>
                        <TextBlock Text="PLAYING" FontSize="10" FontWeight="Bold" LetterSpacing="1"
                                   Foreground="White" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ===== HERO CARD — tempo, beat lights, start/stop, mode switch ===== -->
            <Border Margin="0,0,0,12"
                    CornerRadius="14" Padding="0"
                    BorderThickness="1" BorderBrush="{StaticResource BorderHairline}"
                    ClipToBounds="True">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                        <GradientStop Color="#221B1B28" Offset="0"/>
                        <GradientStop Color="#88141422" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Grid RowDefinitions="4,Auto,Auto">
                    <Border Grid.Row="0" Background="{StaticResource AccentBrush}"/>

                    <Grid Grid.Row="1" Margin="32,28,32,24" ColumnDefinitions="*,Auto">

                        <!-- LEFT: tempo display + beat lights -->
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="0">

                            <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,0,0,4">
                                <Border Width="10" Height="10" CornerRadius="5"
                                        Background="{StaticResource AccentBrush}"
                                        VerticalAlignment="Center"/>
                                <TextBlock Text="TEMPO" FontSize="12" FontWeight="Bold" LetterSpacing="3"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Bottom">
                                <TextBlock Text="{Binding Bpm}"
                                           FontSize="92" FontWeight="Bold"
                                           LineHeight="100"
                                           FontFamily="Segoe UI Variable Display, Segoe UI, $default"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           VerticalAlignment="Bottom"/>
                                <TextBlock Text="BPM"
                                           FontSize="20" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           VerticalAlignment="Bottom"
                                           Margin="0,0,0,12"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2,0,16">
                                <TextBlock Text="{Binding TempoName}"
                                           FontSize="12" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBlock Text="·" FontSize="12"
                                           Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock Text="{Binding IntervalDisplay}"
                                           FontSize="11"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- Beat lights: click one to cycle accent -> normal -> mute -->
                            <ItemsControl ItemsSource="{Binding BeatLights}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="8"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="viewmodel:BeatLight">
                                        <Button Classes="ghost" Padding="3" Cursor="Hand"
                                                Command="{Binding $parent[ItemsControl].((viewmodel:MetronomeViewModel)DataContext).CycleAccentCommand}"
                                                CommandParameter="{Binding}"
                                                ToolTip.Tip="Click to change: accent → normal → mute">
                                            <Border Classes="light"
                                                    Classes.accent="{Binding IsAccent}"
                                                    Classes.muted="{Binding IsMuted}"
                                                    Classes.active="{Binding IsActive}"/>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="Click a beat to accent or mute it"
                                       FontSize="10"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       Margin="3,4,0,0"/>

                        </StackPanel>

                        <!-- RIGHT: current beat + play/stop -->
                        <StackPanel Grid.Column="1" Spacing="14" VerticalAlignment="Center"
                                    Margin="32,0,0,0">

                            <Border Width="120" Height="120" CornerRadius="60"
                                    HorizontalAlignment="Center"
                                    BorderThickness="3"
                                    BorderBrush="{StaticResource AccentBrush}"
                                    Background="{StaticResource AccentSubtleBrush}">
                                <TextBlock Text="{Binding CurrentBeat}"
                                           FontSize="60" FontWeight="Bold"
                                           FontFamily="Segoe UI Variable Display, Segoe UI, $default"
                                           Foreground="{StaticResource AccentBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <Button Classes="primary" Padding="36,11" FontSize="14"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    Command="{Binding TogglePlayCommand}">
                                <Panel>
                                    <TextBlock Text="Stop" FontWeight="SemiBold"
                                               IsVisible="{Binding IsPlaying}"/>
                                    <TextBlock Text="Start" FontWeight="SemiBold"
                                               IsVisible="{Binding !IsPlaying}"/>
                                </Panel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- MODE SWITCH -->
                    <Border Grid.Row="2" Padding="32,14"
                            BorderThickness="0,1,0,0"
                            BorderBrush="{StaticResource BorderHairline}">
                        <Grid ColumnDefinitions="*,8,*">
                            <Button Grid.Column="0"
                                    Classes.primary="{Binding IsClickMode}"
                                    Classes.secondary="{Binding IsDrumsMode}"
                                    HorizontalAlignment="Stretch"
                                    Padding="16,9"
                                    Command="{Binding ShowClickModeCommand}">
                                <TextBlock Text="Click" FontWeight="SemiBold"/>
                            </Button>
                            <Button Grid.Column="2"
                                    Classes.primary="{Binding IsDrumsMode}"
                                    Classes.secondary="{Binding IsClickMode}"
                                    HorizontalAlignment="Stretch"
                                    Padding="16,9"
                                    Command="{Binding ShowDrumsModeCommand}">
                                <TextBlock Text="Drum beats" FontWeight="SemiBold"/>
                            </Button>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- ===== DRUM BEAT ===== -->
            <Border Classes="card" Margin="0,0,0,12" IsVisible="{Binding IsDrumsMode}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14" Spacing="8">
                        <Border Width="3" Height="14" CornerRadius="2"
                                Background="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="DRUM BEAT" FontSize="10" FontWeight="Bold" LetterSpacing="1"
                                   Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Genre / style / kit -->
                    <Grid ColumnDefinitions="150,8,*,8,140" Margin="0,0,0,12">
                        <ComboBox Grid.Column="0"
                                  ItemsSource="{Binding Genres}"
                                  SelectedItem="{Binding SelectedGenre, Mode=TwoWay}"
                                  HorizontalAlignment="Stretch"/>
                        <ComboBox Grid.Column="2"
                                  ItemsSource="{Binding FilteredStyles}"
                                  SelectedItem="{Binding SelectedStyle, Mode=TwoWay}"
                                  HorizontalAlignment="Stretch">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="models:DrumStyle">
                                    <!-- One line, so the closed box is as tall as its neighbours -->
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <TextBlock Text="{Binding Name}" FontSize="13"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Description}" FontSize="11"
                                                   VerticalAlignment="Center"
                                                   Foreground="{StaticResource TextMutedBrush}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <ComboBox Grid.Column="4"
                                  ItemsSource="{Binding KitChoices}"
                                  SelectedItem="{Binding SelectedKit, Mode=TwoWay}"
                                  HorizontalAlignment="Stretch"/>
                    </Grid>

                    <!-- Status line -->
                    <StackPanel Orientation="Horizontal" Spacing="10" Height="24" Margin="0,0,0,12">
                        <Border VerticalAlignment="Center" CornerRadius="6" Padding="10,3"
                                Background="{StaticResource AccentSubtleBrush}"
                                IsVisible="{Binding IsPlaying}">
                            <TextBlock Text="{Binding SectionLabel}"
                                       FontSize="10" FontWeight="Bold" LetterSpacing="1"
                                       Foreground="{StaticResource AccentBrush}"/>
                        </Border>
                        <TextBlock Text="{Binding BarNumber, StringFormat='Bar {0}'}"
                                   FontSize="12" VerticalAlignment="Center"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   IsVisible="{Binding HasBar}"/>
                        <Border VerticalAlignment="Center" CornerRadius="6" Padding="8,3"
                                Background="{StaticResource WarningSubtleBrush}"
                                IsVisible="{Binding IsGapMuted}">
                            <TextBlock Text="MUTED"
                                       FontSize="10" FontWeight="Bold" LetterSpacing="1"
                                       Foreground="{StaticResource WarningBrush}"/>
                        </Border>
                    </StackPanel>

                    <!-- Pedal row -->
                    <UniformGrid Columns="4" Margin="0,0,0,12">
                        <Button Classes="secondary" Padding="10,14" Margin="0,0,8,0"
                                HorizontalAlignment="Stretch"
                                IsEnabled="{Binding IsPlaying}"
                                Command="{Binding FillCommand}">
                            <StackPanel Spacing="2">
                                <TextBlock Text="Fill" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                <TextBlock Text="Play a fill" FontSize="10" HorizontalAlignment="Center"
                                           Foreground="{StaticResource TextMutedBrush}"/>
                            </StackPanel>
                        </Button>
                        <Button Classes="secondary" Padding="10,14" Margin="0,0,8,0"
                                HorizontalAlignment="Stretch"
                                IsEnabled="{Binding CanNextPart}"
                                Command="{Binding NextPartCommand}">
                            <StackPanel Spacing="2">
                                <TextBlock Text="Next part" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding NextPartName, StringFormat='→ {0}'}"
                                           FontSize="10" HorizontalAlignment="Center"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           IsVisible="{Binding HasMultipleParts}"/>
                                <TextBlock Text="Single part"
                                           FontSize="10" HorizontalAlignment="Center"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           IsVisible="{Binding !HasMultipleParts}"/>
                            </StackPanel>
                        </Button>
                        <Button Classes="secondary" Padding="10,14" Margin="0,0,8,0"
                                HorizontalAlignment="Stretch"
                                Command="{Binding AccentHitCommand}">
                            <StackPanel Spacing="2">
                                <TextBlock Text="Accent hit" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                <TextBlock Text="Crash!" FontSize="10" HorizontalAlignment="Center"
                                           Foreground="{StaticResource TextMutedBrush}"/>
                            </StackPanel>
                        </Button>
                        <Button Classes="secondary" Padding="10,14"
                                HorizontalAlignment="Stretch"
                                IsEnabled="{Binding IsPlaying}"
                                Command="{Binding OutroCommand}">
                            <StackPanel Spacing="2">
                                <TextBlock Text="Outro" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                <TextBlock Text="Ending fill, then stop" FontSize="10" HorizontalAlignment="Center"
                                           Foreground="{StaticResource TextMutedBrush}"/>
                            </StackPanel>
                        </Button>
                    </UniformGrid>

                    <!-- Pattern grid -->
                    <Border Classes="card-inner" Margin="0,0,0,14" IsVisible="{Binding HasPattern}">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Disabled">
                            <StackPanel Margin="0,0,0,6">
                                <ItemsControl ItemsSource="{Binding StepMarkers}" Margin="64,0,0,6">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="viewmodel:StepMarker">
                                            <Border Classes="marker"
                                                    Width="{Binding Width}"
                                                    Classes.beat="{Binding IsBeatStart}"
                                                    Classes.current="{Binding IsCurrent}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <ItemsControl ItemsSource="{Binding PatternRows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="viewmodel:PatternRow">
                                            <Grid ColumnDefinitions="64,Auto" Margin="0,0,0,3">
                                                <TextBlock Grid.Column="0" Text="{Binding Label}"
                                                           FontSize="11"
                                                           Foreground="{StaticResource TextMutedBrush}"
                                                           VerticalAlignment="Center"/>
                                                <ItemsControl Grid.Column="1" ItemsSource="{Binding Cells}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <StackPanel Orientation="Horizontal"/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="viewmodel:PatternCell">
                                                            <Border Classes="cell"
                                                                    Width="{Binding Width}"
                                                                    Classes.beat="{Binding IsBeatStart}"
                                                                    Classes.hit="{Binding IsHit}"
                                                                    Opacity="{Binding CellOpacity}"/>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <!-- Options -->
                    <WrapPanel Orientation="Horizontal">
                        <CheckBox Content="Count-in" IsChecked="{Binding CountIn, Mode=TwoWay}"
                                  FontSize="12" Margin="0,0,18,0" VerticalAlignment="Center"/>
                        <CheckBox Content="Intro fill" IsChecked="{Binding IntroFill, Mode=TwoWay}"
                                  FontSize="12" Margin="0,0,18,0" VerticalAlignment="Center"/>
                        <CheckBox Content="Click on top" IsChecked="{Binding ClickWithDrums, Mode=TwoWay}"
                                  FontSize="12" Margin="0,0,18,0" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock Text="Auto-fill" FontSize="12"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       VerticalAlignment="Center"/>
                            <ComboBox ItemsSource="{Binding AutoFillChoices}"
                                      SelectedItem="{Binding SelectedAutoFill, Mode=TwoWay}"
                                      Width="150"/>
                        </StackPanel>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- ===== TEMPO ===== -->
            <Border Classes="card" Margin="0,0,0,12">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14" Spacing="8">
                        <Border Width="3" Height="14" CornerRadius="2"
                                Background="{StaticResource InfoBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="TEMPO" FontSize="10" FontWeight="Bold" LetterSpacing="1"
                                   Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <Grid ColumnDefinitions="Auto,6,Auto,*,Auto,6,Auto,Auto" Margin="0,0,0,14">
                        <Button Grid.Column="0" Classes="secondary"
                                Padding="12,9" FontSize="13" FontWeight="Bold"
                                Content="−5"
                                ToolTip.Tip="Decrease BPM by 5"
                                Command="{Binding BpmDownFiveCommand}"/>
                        <Button Grid.Column="2" Classes="secondary"
                                Padding="14,9" FontSize="14" FontWeight="Bold"
                                Content="−"
                                ToolTip.Tip="Decrease BPM by 1"
                                Command="{Binding BpmDecreaseCommand}"/>
                        <Slider Grid.Column="3"
                                Minimum="30" Maximum="280"
                                Value="{Binding Bpm, Mode=TwoWay}"
                                VerticalAlignment="Center"
                                Margin="14,0,14,0"
                                TickFrequency="10"/>
                        <Button Grid.Column="4" Classes="secondary"
                                Padding="14,9" FontSize="14" FontWeight="Bold"
                                Content="+"
                                ToolTip.Tip="Increase BPM by 1"
                                Command="{Binding BpmIncreaseCommand}"/>
                        <Button Grid.Column="6" Classes="secondary"
                                Padding="12,9" FontSize="13" FontWeight="Bold"
                                Content="+5"
                                ToolTip.Tip="Increase BPM by 5"
                                Command="{Binding BpmUpFiveCommand}"/>
                        <TextBox Grid.Column="7"
                                 Text="{Binding Bpm, Mode=TwoWay, Converter={StaticResource FlexInt}}"
                                 Classes="input" Width="70"
                                 FontSize="15" FontWeight="SemiBold"
                                 Margin="14,0,0,0"/>
                    </Grid>

                    <!-- Volume row -->
                    <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,14">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6"
                                    VerticalAlignment="Center" Width="90">
                            <TextBlock Text="&#xE767;" FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets"
                                       FontSize="14" Foreground="{StaticResource TextMutedBrush}"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="VOLUME" FontSize="9" FontWeight="Bold" LetterSpacing="1"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <Slider Grid.Column="1"
                                Minimum="0" Maximum="1"
                                Value="{Binding Volume, Mode=TwoWay}"
                                VerticalAlignment="Center"
                                Margin="10,0,10,0"/>
                        <TextBlock Grid.Column="2"
                                   Text="{Binding Volume, StringFormat={}{0:P0}}"
                                   FontSize="12" FontWeight="SemiBold" Width="42"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   VerticalAlignment="Center" TextAlignment="Right"/>
                    </Grid>

                    <!-- Tap tempo + presets -->
                    <Grid ColumnDefinitions="Auto,12,*">
                        <Button Grid.Column="0" Classes="secondary"
                                Padding="22,12" FontSize="13"
                                VerticalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                Command="{Binding TapTempoCommand}"
                                ToolTip.Tip="Click in rhythm at least twice to set the BPM">
                            <TextBlock Text="Tap tempo" FontWeight="SemiBold"/>
                        </Button>
                        <ItemsControl Grid.Column="2" ItemsSource="{Binding Presets}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="6"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="viewmodel:MetronomePreset">
                                    <Button Classes="secondary" Padding="4,8" Margin="0,0,6,0"
                                            HorizontalAlignment="Stretch"
                                            ToolTip.Tip="{Binding Italian}"
                                            Command="{Binding $parent[ItemsControl].((viewmodel:MetronomeViewModel)DataContext).ApplyPresetCommand}"
                                            CommandParameter="{Binding}">
                                        <StackPanel Spacing="1">
                                            <TextBlock Text="{Binding Name}" FontSize="11"
                                                       HorizontalAlignment="Center"
                                                       Foreground="{StaticResource TextMutedBrush}"/>
                                            <TextBlock Text="{Binding Bpm}" FontSize="15" FontWeight="Bold"
                                                       HorizontalAlignment="Center"
                                                       Foreground="{StaticResource AccentBrush}"/>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ===== CLICK ===== -->
            <Border Classes="card" Margin="0,0,0,12" IsVisible="{Binding IsClickMode}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14" Spacing="8">
                        <Border Width="3" Height="14" CornerRadius="2"
                                Background="{StaticResource SuccessBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="CLICK" FontSize="10" FontWeight="Bold" LetterSpacing="1"
                                   Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <Grid ColumnDefinitions="*,12,*,12,*">
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="SOUND"
                                       FontSize="9" FontWeight="Bold" LetterSpacing="1"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       Margin="0,0,0,6"/>
                            <ComboBox ItemsSource="{Binding SoundChoices}"
                                      SelectedItem="{Binding SelectedSound, Mode=TwoWay}"
                                      HorizontalAlignment="Stretch"
                                      ToolTip.Tip="Pick the click timbre — selecting one previews it"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="BEATS PER BAR"
                                       FontSize="9" FontWeight="Bold" LetterSpacing="1"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       Margin="0,0,0,6"/>
                            <ComboBox ItemsSource="{Binding BeatChoices}"
                                      SelectedItem="{Binding BeatsPerMeasure, Mode=TwoWay}"
                                      HorizontalAlignment="Stretch"/>
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="SUBDIVISION"
                                       FontSize="9" FontWeight="Bold" LetterSpacing="1"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       Margin="0,0,0,6"/>
                            <ComboBox ItemsSource="{Binding SubdivisionChoices}"
                                      SelectedItem="{Binding SelectedSubdivision, Mode=TwoWay}"
                                      HorizontalAlignment="Stretch"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ===== PRACTICE TOOLS ===== -->
            <Border Classes="card" Margin="0,0,0,12">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14" Spacing="8">
                        <Border Width="3" Height="14" CornerRadius="2"
                                Background="{StaticResource WarningBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="PRACTICE TOOLS" FontSize="10" FontWeight="Bold" LetterSpacing="1"
                                   Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <Grid ColumnDefinitions="*,12,*">
                        <!-- Speed trainer -->
                        <Border Grid.Column="0" Classes="card-inner">
                            <StackPanel>
                                <TextBlock Text="SPEED TRAINER"
                                           FontSize="9" FontWeight="Bold" LetterSpacing="1"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           Margin="0,0,0,8"/>
                                <CheckBox Content="Speed up as I play"
                                          IsChecked="{Binding TrainerEnabled, Mode=TwoWay}"
                                          FontSize="12" Margin="0,0,0,8"/>
                                <Grid ColumnDefinitions="78,110,*" RowDefinitions="Auto,Auto,Auto">
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Add" FontSize="12" VerticalAlignment="Center"
                                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <NumericUpDown Grid.Row="0" Grid.Column="1" Minimum="1" Maximum="50" Increment="1"
                                                   FormatString="0" Margin="0,3"
                                                   Value="{Binding TrainerStepBpm, Mode=TwoWay}"/>
                                    <TextBlock Grid.Row="0" Grid.Column="2" Text="BPM" FontSize="12" VerticalAlignment="Center"
                                               Foreground="{StaticResource TextSecondaryBrush}" Margin="8,0,0,0"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="every" FontSize="12" VerticalAlignment="Center"
                                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <NumericUpDown Grid.Row="1" Grid.Column="1" Minimum="1" Maximum="64" Increment="1"
                                                   FormatString="0" Margin="0,3"
                                                   Value="{Binding TrainerEveryBars, Mode=TwoWay}"/>
                                    <TextBlock Grid.Row="1" Grid.Column="2" Text="bars" FontSize="12" VerticalAlignment="Center"
                                               Foreground="{StaticResource TextSecondaryBrush}" Margin="8,0,0,0"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="up to" FontSize="12" VerticalAlignment="Center"
                                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <NumericUpDown Grid.Row="2" Grid.Column="1" Minimum="30" Maximum="280" Increment="1"
                                                   FormatString="0" Margin="0,3"
                                                   Value="{Binding TrainerTargetBpm, Mode=TwoWay}"/>
                                    <TextBlock Grid.Row="2" Grid.Column="2" Text="BPM" FontSize="12" VerticalAlignment="Center"
                                               Foreground="{StaticResource TextSecondaryBrush}" Margin="8,0,0,0"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Gap trainer -->
                        <Border Grid.Column="2" Classes="card-inner">
                            <StackPanel>
                                <TextBlock Text="GAP TRAINER"
                                           FontSize="9" FontWeight="Bold" LetterSpacing="1"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           Margin="0,0,0,8"/>
                                <CheckBox Content="Drop out to test my timing"
                                          IsChecked="{Binding GapEnabled, Mode=TwoWay}"
                                          FontSize="12" Margin="0,0,0,8"/>
                                <Grid ColumnDefinitions="78,110,*" RowDefinitions="Auto,Auto">
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Play" FontSize="12" VerticalAlignment="Center"
                                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <NumericUpDown Grid.Row="0" Grid.Column="1" Minimum="1" Maximum="16" Increment="1"
                                                   FormatString="0" Margin="0,3"
                                                   Value="{Binding GapPlayBars, Mode=TwoWay}"/>
                                    <TextBlock Grid.Row="0" Grid.Column="2" Text="bars" FontSize="12" VerticalAlignment="Center"
                                               Foreground="{StaticResource TextSecondaryBrush}" Margin="8,0,0,0"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="then silent" FontSize="12" VerticalAlignment="Center"
                                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <NumericUpDown Grid.Row="1" Grid.Column="1" Minimum="1" Maximum="16" Increment="1"
                                                   FormatString="0" Margin="0,3"
                                                   Value="{Binding GapMuteBars, Mode=TwoWay}"/>
                                    <TextBlock Grid.Row="1" Grid.Column="2" Text="bars" FontSize="12" VerticalAlignment="Center"
                                               Foreground="{StaticResource TextSecondaryBrush}" Margin="8,0,0,0"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Height="48"/>
        </StackPanel>
        </Border>
    </ScrollViewer>
</UserControl>
