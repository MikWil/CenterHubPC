<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewmodel="clr-namespace:CenterHubNew.MVVM.ViewModel"
             xmlns:svc="clr-namespace:CenterHubNew.MVVM.Services"
             x:Class="CenterHubNew.MVVM.View.RoutingView"
             x:DataType="viewmodel:RoutingViewModel"
             mc:Ignorable="d"
             Background="Transparent">

    <UserControl.Styles>
        <Style Selector="Button.chip">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderHairline}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="999"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        </Style>
        <Style Selector="Button.chip.active">
            <Setter Property="Background" Value="{StaticResource AccentSubtleBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
        </Style>

        <Style Selector="ToggleButton.route">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderHairline}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="999"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="MinWidth" Value="72"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
        </Style>
        <Style Selector="ToggleButton.you:checked">
            <Setter Property="Background" Value="#173C31"/>
            <Setter Property="BorderBrush" Value="#1D9E75"/>
            <Setter Property="Foreground" Value="#5DCAA5"/>
        </Style>
        <Style Selector="ToggleButton.others:checked">
            <Setter Property="Background" Value="#241F4A"/>
            <Setter Property="BorderBrush" Value="#7F77DD"/>
            <Setter Property="Foreground" Value="#AFA9EC"/>
        </Style>
    </UserControl.Styles>

    <StackPanel Spacing="10">

        <!-- PRESET BAR -->
        <Border Classes="card">
            <StackPanel Spacing="12">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <TextBlock Grid.Column="0" Text="PRESETS" FontSize="10" FontWeight="Bold" LetterSpacing="1"
                               Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <ItemsControl Grid.Column="1" ItemsSource="{Binding PresetChips}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="viewmodel:PresetChip">
                                <Button Classes="chip" Classes.active="{Binding IsActive}"
                                        Content="{Binding Name}" Margin="0,0,8,0"
                                        Command="{Binding $parent[ItemsControl].((viewmodel:RoutingViewModel)DataContext).ApplyPresetCommand}"
                                        CommandParameter="{Binding}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Grid.Column="2" Text="{Binding StatusText}" FontSize="11" FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                </Grid>

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBox Text="{Binding CurrentPresetName, Mode=TwoWay}" Width="200"
                             Watermark="Preset name"/>
                    <Button Content="New preset" Classes="secondary" Padding="14,8"
                            Command="{Binding NewPresetCommand}"/>
                    <Button Content="Delete" Classes="danger" Padding="14,8"
                            Command="{Binding DeleteCurrentCommand}"/>
                    <Border Width="1" Background="{StaticResource BorderHairline}" Margin="4,2"/>
                    <Button Content="↻ Refresh / re-sync" Classes="primary" Padding="14,8"
                            Command="{Binding ResyncCommand}"
                            IsEnabled="{Binding !IsBusy}"
                            ToolTip.Tip="Reconnect, restart the audio engine, and reassign all devices and routing"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- NOT INSTALLED -->
        <Border Classes="card" IsVisible="{Binding !IsInstalled}">
            <TextBlock Text="Voicemeeter Banana isn't installed. Install it (and reboot) to route audio with flows."
                       TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
        </Border>

        <!-- FLOW BOARD -->
        <Grid ColumnDefinitions="*,16,320" IsVisible="{Binding IsInstalled}">

            <!-- SOURCES -->
            <Border Grid.Column="0" Classes="card">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12" Spacing="8">
                        <Border Width="3" Height="16" CornerRadius="2" Background="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="Sources" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="teal = you hear   ·   purple = others hear" FontSize="10"
                                   Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                    </StackPanel>

                    <ItemsControl ItemsSource="{Binding Sources}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="viewmodel:RoutingSourceRow">
                                <Border Classes="card-inner" Margin="0,0,0,8">
                                    <Grid ColumnDefinitions="*,Auto,Auto">
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="4">
                                            <TextBox Text="{Binding DisplayName, Mode=TwoWay}"
                                                     FontSize="13" FontWeight="SemiBold" Background="Transparent"
                                                     BorderThickness="0" Padding="0"
                                                     Foreground="{StaticResource TextPrimaryBrush}"/>
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Slider Minimum="-60" Maximum="12" Width="150" VerticalAlignment="Center"
                                                        Value="{Binding GainDb, Mode=TwoWay}"/>
                                                <TextBlock Text="{Binding GainDb, StringFormat='{}{0:F0} dB'}"
                                                           FontSize="11" MinWidth="46" VerticalAlignment="Center"
                                                           Foreground="{StaticResource TextMutedBrush}"/>
                                                <ComboBox IsVisible="{Binding IsVirtualApp}" MinWidth="170"
                                                          PlaceholderText="Send an app here…"
                                                          ItemsSource="{Binding Apps}"
                                                          SelectedItem="{Binding SelectedApp}">
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate x:DataType="svc:AudioAppInfo">
                                                            <TextBlock Text="{Binding DisplayName}"/>
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>
                                            </StackPanel>
                                        </StackPanel>

                                        <ToggleButton Grid.Column="1" Classes="route you" Content="You"
                                                      Margin="6,0,6,0" VerticalAlignment="Center"
                                                      IsChecked="{Binding ToYou, Mode=TwoWay}"/>
                                        <ToggleButton Grid.Column="2" Classes="route others" Content="Others"
                                                      VerticalAlignment="Center"
                                                      IsVisible="{Binding CanSendToOthers}"
                                                      IsChecked="{Binding ToOthers, Mode=TwoWay}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- DESTINATIONS -->
            <StackPanel Grid.Column="2" Spacing="10">
                <Border Classes="card" BorderBrush="#1D9E75" BorderThickness="1">
                    <StackPanel Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="&#xE7F5;" FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets"
                                       FontSize="16" Foreground="#5DCAA5" VerticalAlignment="Center"/>
                            <TextBlock Text="You hear" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="headphones" FontSize="10" Foreground="{StaticResource TextMutedBrush}"
                                       VerticalAlignment="Center" Margin="4,0,0,0"/>
                        </StackPanel>
                        <TextBlock Text="{Binding YouHearSummary}" TextWrapping="Wrap" FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Border>

                <Border Classes="card" BorderBrush="#7F77DD" BorderThickness="1">
                    <StackPanel Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="&#xE789;" FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets"
                                       FontSize="16" Foreground="#AFA9EC" VerticalAlignment="Center"/>
                            <TextBlock Text="Others hear" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="Discord" FontSize="10" Foreground="{StaticResource TextMutedBrush}"
                                       VerticalAlignment="Center" Margin="4,0,0,0"/>
                        </StackPanel>
                        <TextBlock Text="{Binding OthersHearSummary}" TextWrapping="Wrap" FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <!-- Extra app slot via VB-Cable -->
        <Border Classes="card" IsVisible="{Binding !IsVbCableInstalled}">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBlock Text="Want another app slot? Banana has no spare virtual input — install the free VB-Audio Virtual Cable and a second application slot appears here automatically."
                           TextWrapping="Wrap" FontSize="12" VerticalAlignment="Center"
                           Foreground="{StaticResource TextMutedBrush}" MaxWidth="520"/>
                <Button Content="Get VB-Cable" Classes="secondary" Padding="14,8"
                        VerticalAlignment="Center"
                        Command="{Binding InstallVbCableCommand}"/>
            </StackPanel>
        </Border>

        <!-- SETUP (collapsible — devices folded in from the old Devices card) -->
        <Expander Header="Setup — pick your devices" IsExpanded="False"
                  IsVisible="{Binding IsInstalled}" HorizontalAlignment="Stretch">
            <StackPanel Spacing="14" Margin="0,10,0,0">
                <Grid ColumnDefinitions="*,12,*,12,*">
                    <StackPanel Grid.Column="0" Spacing="4">
                        <TextBlock Text="MICROPHONE" FontSize="10" FontWeight="Bold" LetterSpacing="1"
                                   Foreground="{StaticResource TextMutedBrush}"/>
                        <ComboBox HorizontalAlignment="Stretch"
                                  ItemsSource="{Binding Devices.MicrophoneDevices}"
                                  SelectedItem="{Binding Devices.SelectedMicrophone}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="svc:AudioDeviceInfo">
                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Spacing="4">
                        <TextBlock Text="GUITAR (KATANA)" FontSize="10" FontWeight="Bold" LetterSpacing="1"
                                   Foreground="{StaticResource TextMutedBrush}"/>
                        <ComboBox HorizontalAlignment="Stretch"
                                  ItemsSource="{Binding Devices.GuitarDevices}"
                                  SelectedItem="{Binding Devices.SelectedGuitar}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="svc:AudioDeviceInfo">
                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock Text="{Binding Devices.GuitarUnavailableText}"
                                   IsVisible="{Binding Devices.GuitarUnavailable}"
                                   FontSize="11" Foreground="{StaticResource ErrorBrush}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="4" Spacing="4">
                        <TextBlock Text="YOU LISTEN WITH" FontSize="10" FontWeight="Bold" LetterSpacing="1"
                                   Foreground="{StaticResource TextMutedBrush}"/>
                        <ComboBox HorizontalAlignment="Stretch"
                                  ItemsSource="{Binding Devices.MonitorDevices}"
                                  SelectedItem="{Binding Devices.SelectedMonitor}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="svc:AudioDeviceInfo">
                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                </Grid>

                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button Content="Open Voicemeeter" Classes="secondary" Padding="14,8"
                            Command="{Binding Devices.OpenVoicemeeterCommand}"/>
                    <Button Content="Refresh devices" Classes="secondary" Padding="14,8"
                            Command="{Binding Devices.RefreshDevicesCommand}"/>
                    <Button Content="Refresh apps" Classes="secondary" Padding="14,8"
                            Command="{Binding RefreshAppsCommand}"/>
                </StackPanel>
            </StackPanel>
        </Expander>
    </StackPanel>
</UserControl>
