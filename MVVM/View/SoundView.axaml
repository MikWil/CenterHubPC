<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewmodel="clr-namespace:CenterHubNew.MVVM.ViewModel"
             xmlns:svc="clr-namespace:CenterHubNew.MVVM.Services"
             xmlns:controls="clr-namespace:CenterHubNew.MVVM.Controls"
             x:Class="CenterHubNew.MVVM.View.SoundView"
             x:DataType="viewmodel:SoundViewModel"
             mc:Ignorable="d"
             Background="Transparent">

    <controls:PageHost Title="Sound"
                       Subtitle="Route what you hear and what others hear — save it as a preset"
                       Mode="Data">
        <StackPanel Spacing="0">

            <!-- ROUTING BOARD (presets + flows) -->
            <ContentControl Content="{Binding Routing}" Margin="0,0,0,10"/>

            <!-- QUICK CONTROLS: mic, volume and output device flow onto new lines when the page is narrow -->
            <Border Classes="card" Margin="0,0,0,10">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14" Spacing="8">
                        <Border Width="3" Height="16" CornerRadius="2"
                                Background="{DynamicResource InfoBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="Quick Controls"
                                   FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <WrapPanel Orientation="Horizontal">

                        <!-- Mic mute -->
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center"
                                    Margin="0,0,28,10">
                            <TextBlock Text="MIC" FontSize="10" FontWeight="Bold" LetterSpacing="1"
                                       Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                            <Button Content="{Binding MicrophoneMuteButtonText}"
                                    Classes="secondary"
                                    Command="{Binding ToggleMicrophoneMuteCommand}"
                                    Padding="12,7"/>
                        </StackPanel>

                        <!-- Volume slider -->
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center"
                                    Margin="0,0,28,10">
                            <TextBlock Text="VOLUME" FontSize="10" FontWeight="Bold" LetterSpacing="1"
                                       Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                            <Slider Minimum="0" Maximum="1"
                                    Value="{Binding OutputVolume, Mode=TwoWay}"
                                    Width="140" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding OutputVolume, StringFormat='{}{0:P0}'}"
                                       FontSize="13" FontWeight="SemiBold"
                                       VerticalAlignment="Center" MinWidth="38"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </StackPanel>

                        <!-- Output device (wraps by itself if the row is too narrow for combo + buttons) -->
                        <WrapPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,10">
                            <ComboBox ItemsSource="{Binding ActiveSoundSource}"
                                      SelectedItem="{Binding SelectedSoundSource}"
                                      Width="180" Margin="0,0,6,0"/>
                            <Button Content="Set Audio" Classes="primary" Padding="10,7" Margin="0,0,6,0"
                                    Command="{Binding SetDefaultPlaybackDeviceCommand}"/>
                            <Button Content="Set Comm" Classes="secondary" Padding="10,7"
                                    Command="{Binding SetDefaultCommunicationDeviceCommand}"/>
                        </WrapPanel>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- ADVANCED -->
            <Border Classes="card" Margin="0,0,0,0">
                <WrapPanel Orientation="Horizontal">
                    <Button Content="Open Advanced Sound Controls"
                            Classes="secondary" Padding="16,9" Margin="0,0,12,0"
                            Click="OpenSoundControlsWindow_Click"/>
                    <TextBlock Text="Manage per-application volumes, equalizer, and devices"
                               FontSize="12" Foreground="{DynamicResource TextMutedBrush}"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center"/>
                </WrapPanel>
            </Border>

        </StackPanel>
    </controls:PageHost>
</UserControl>
