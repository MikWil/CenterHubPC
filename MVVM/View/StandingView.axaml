<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewmodel="clr-namespace:CenterHubNew.MVVM.ViewModel"
             xmlns:conv="clr-namespace:CenterHubNew.MVVM.Converters"
             xmlns:controls="clr-namespace:CenterHubNew.MVVM.Controls"
             x:Class="CenterHubNew.MVVM.View.StandingView"
             x:DataType="viewmodel:StandingViewModel"
             mc:Ignorable="d"
             controls:Responsive.NarrowBelow="620"
             Background="Transparent">

    <UserControl.Resources>
        <conv:FlexibleIntConverter x:Key="FlexInt"/>
    </UserControl.Resources>

    <UserControl.Styles>
        <!-- Hero panel: actions sit right of the countdown; under it when narrow -->
        <Style Selector="StackPanel.heroActions">
            <Setter Property="Grid.Row" Value="0"/>
            <Setter Property="Grid.Column" Value="1"/>
            <Setter Property="Grid.ColumnSpan" Value="1"/>
            <Setter Property="Orientation" Value="Vertical"/>
            <Setter Property="Margin" Value="20,0,0,0"/>
        </Style>
        <Style Selector="UserControl:narrow StackPanel.heroActions">
            <Setter Property="Grid.Row" Value="1"/>
            <Setter Property="Grid.Column" Value="0"/>
            <Setter Property="Grid.ColumnSpan" Value="2"/>
            <Setter Property="Orientation" Value="Horizontal"/>
            <Setter Property="Margin" Value="0,16,0,0"/>
        </Style>
        <Style Selector="Grid.heroBody">
            <Setter Property="Margin" Value="32,28,32,26"/>
        </Style>
        <Style Selector="UserControl:narrow Grid.heroBody">
            <Setter Property="Margin" Value="18,20,18,18"/>
        </Style>
        <Style Selector="TextBlock.bigTime">
            <Setter Property="FontSize" Value="92"/>
            <Setter Property="LineHeight" Value="100"/>
        </Style>
        <Style Selector="UserControl:narrow TextBlock.bigTime">
            <Setter Property="FontSize" Value="64"/>
            <Setter Property="LineHeight" Value="72"/>
        </Style>
    </UserControl.Styles>

    <controls:PageHost Title="Standing Timer"
                       Subtitle="Alternate sitting and standing throughout the day"
                       Mode="Reading">

        <controls:PageHost.HeaderBadge>
            <!-- Live status pill -->
            <Border VerticalAlignment="Center"
                    CornerRadius="6" Padding="10,5"
                    IsVisible="{Binding IsRunning}">
                <Border.Styles>
                    <Style Selector="Border">
                        <Setter Property="Background" Value="{DynamicResource SuccessBrush}"/>
                    </Style>
                </Border.Styles>
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Border Width="6" Height="6" CornerRadius="3"
                            Background="White" VerticalAlignment="Center"/>
                    <TextBlock Text="LIVE" FontSize="10" FontWeight="Bold" LetterSpacing="1"
                               Foreground="White" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
        </controls:PageHost.HeaderBadge>

        <StackPanel Spacing="0">

            <!-- ===== HERO PANEL (running) ===== -->
            <Border Margin="0,0,0,12"
                    CornerRadius="14" Padding="0"
                    BorderThickness="1" BorderBrush="{DynamicResource BorderHairline}"
                    ClipToBounds="True"
                    IsVisible="{Binding IsRunning}" Background="{DynamicResource HeroBackgroundBrush}">
                <!-- RowDefinitions MUST use Auto, not *, for the content row. -->
                <Grid RowDefinitions="4,Auto">

                    <!-- Top colored stripe (changes per phase via Style) -->
                    <Border Grid.Row="0">
                        <Border.Styles>
                            <Style Selector="Border">
                                <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                            </Style>
                        </Border.Styles>
                    </Border>

                    <Grid Grid.Row="1" Classes="heroBody"
                          ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">

                        <!-- LEFT: phase + big countdown -->
                        <StackPanel Grid.Row="0" Grid.Column="0" VerticalAlignment="Center">
                            <!-- Phase label with colored dot -->
                            <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,0,0,4">
                                <Border Width="10" Height="10" CornerRadius="5"
                                        Background="{DynamicResource AccentBrush}"
                                        VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding PhaseLabel}"
                                           FontSize="12" FontWeight="Bold" LetterSpacing="3"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                            <TextBlock Text="{Binding TimeRemainingDisplay}"
                                       Classes="bigTime"
                                       FontWeight="Bold"
                                       FontFamily="Segoe UI Variable Display, Segoe UI, $default"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>

                            <TextBlock Text="{Binding PhaseGuidance}"
                                       FontSize="13"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Margin="0,4,0,12"/>

                            <ProgressBar Value="{Binding PhaseProgress}"
                                         Maximum="1" Minimum="0"
                                         Height="6"
                                         HorizontalAlignment="Stretch"
                                         Foreground="{DynamicResource AccentBrush}"
                                         Margin="0,0,0,14"/>

                            <WrapPanel Orientation="Horizontal">
                                <StackPanel Margin="0,0,20,6">
                                    <TextBlock Text="NEXT SWITCH"
                                               FontSize="9" FontWeight="Bold" LetterSpacing="1"
                                               Foreground="{DynamicResource TextMutedBrush}"/>
                                    <TextBlock Text="{Binding NextSwitchAtDisplay}"
                                               FontSize="16" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,20,6">
                                    <TextBlock Text="SESSION"
                                               FontSize="9" FontWeight="Bold" LetterSpacing="1"
                                               Foreground="{DynamicResource TextMutedBrush}"/>
                                    <TextBlock Text="{Binding SessionElapsedDisplay}"
                                               FontSize="16" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,0,6">
                                    <TextBlock Text="CYCLES"
                                               FontSize="9" FontWeight="Bold" LetterSpacing="1"
                                               Foreground="{DynamicResource TextMutedBrush}"/>
                                    <TextBlock Text="{Binding CyclesCompleted}"
                                               FontSize="16" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                </StackPanel>
                            </WrapPanel>
                        </StackPanel>

                        <!-- RIGHT (under the countdown when narrow): actions -->
                        <StackPanel Classes="heroActions" Spacing="10" VerticalAlignment="Center">
                            <Button Content="Skip Phase" Classes="secondary"
                                    Padding="20,10" FontSize="13"
                                    HorizontalContentAlignment="Center"
                                    Command="{Binding SkipPhaseCommand}"/>
                            <Button Content="Stop" Classes="danger"
                                    Padding="20,10" FontSize="13"
                                    HorizontalContentAlignment="Center"
                                    Command="{Binding StopTimersCommand}"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- ===== IDLE BANNER (not running) ===== -->
            <Border Classes="card" Margin="0,0,0,12"
                    IsVisible="{Binding !IsRunning}">
                <Grid ColumnDefinitions="Auto,*">
                    <Border Grid.Column="0"
                            Width="56" Height="56" CornerRadius="12"
                            Background="{DynamicResource AccentSubtleBrush}"
                            BorderThickness="1" BorderBrush="{DynamicResource AccentBrush}"
                            VerticalAlignment="Center">
                        <TextBlock Text="ST" FontSize="14" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{DynamicResource AccentBrush}"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Ready to start"
                                   FontSize="16" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="{Binding PhaseGuidance}"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ===== PRESETS ===== -->
            <Border Classes="card" Margin="0,0,0,12">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14" Spacing="8">
                        <Border Width="3" Height="14" CornerRadius="2"
                                Background="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="PRESETS" FontSize="10" FontWeight="Bold" LetterSpacing="1"
                                   Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <ItemsControl ItemsSource="{Binding Presets}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <controls:AdaptiveColumnsPanel MinColumnWidth="150" MaxColumns="4"
                                                               ColumnSpacing="8" RowSpacing="8"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="viewmodel:StandingPreset">
                                <Button Background="Transparent" BorderThickness="0" Padding="0"
                                        Cursor="Hand"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch"
                                        HorizontalContentAlignment="Stretch"
                                        VerticalContentAlignment="Stretch"
                                        Command="{Binding $parent[ItemsControl].((viewmodel:StandingViewModel)DataContext).ApplyPresetCommand}"
                                        CommandParameter="{Binding}">
                                    <Border Background="{DynamicResource CardInnerBrush}"
                                            CornerRadius="10" Padding="14,12"
                                            BorderThickness="1" BorderBrush="{DynamicResource BorderHairline}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}"
                                                       FontSize="13" FontWeight="SemiBold"
                                                       TextWrapping="Wrap"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBlock Text="{Binding Subtitle}"
                                                       FontSize="11"
                                                       TextWrapping="Wrap"
                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                       Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- ===== CONFIGURATION ===== -->
            <Border Classes="card" Margin="0,0,0,12">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14" Spacing="8">
                        <Border Width="3" Height="14" CornerRadius="2"
                                Background="{DynamicResource SuccessBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="CONFIGURATION" FontSize="10" FontWeight="Bold" LetterSpacing="1"
                                   Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <controls:AdaptiveColumnsPanel MinColumnWidth="240" MaxColumns="2"
                                                   ColumnSpacing="12" RowSpacing="12"
                                                   Margin="0,0,0,16">
                        <Border Classes="card-inner">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="SIT FOR" FontSize="9" FontWeight="Bold" LetterSpacing="1"
                                               Foreground="{DynamicResource InfoBrush}"/>
                                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,4,0,0">
                                        <TextBox Text="{Binding SittingMinutes, Mode=TwoWay, Converter={StaticResource FlexInt}}"
                                                 Classes="input" Width="80" FontSize="20" FontWeight="SemiBold"/>
                                        <TextBlock Text="min" FontSize="12" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextMutedBrush}"/>
                                    </StackPanel>
                                </StackPanel>
                                <Border Grid.Column="1" Width="40" Height="40" CornerRadius="20"
                                        Background="{DynamicResource AccentSubtleBrush}"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="Sit" FontSize="11" FontWeight="Bold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Foreground="{DynamicResource AccentBrush}"/>
                                </Border>
                            </Grid>
                        </Border>

                        <Border Classes="card-inner">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="THEN STAND FOR" FontSize="9" FontWeight="Bold" LetterSpacing="1"
                                               Foreground="{DynamicResource SuccessBrush}"/>
                                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,4,0,0">
                                        <TextBox Text="{Binding StandingMinutes, Mode=TwoWay, Converter={StaticResource FlexInt}}"
                                                 Classes="input" Width="80" FontSize="20" FontWeight="SemiBold"/>
                                        <TextBlock Text="min" FontSize="12" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextMutedBrush}"/>
                                    </StackPanel>
                                </StackPanel>
                                <Border Grid.Column="1" Width="40" Height="40" CornerRadius="20"
                                        Background="{DynamicResource SuccessSubtleBrush}"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="Up" FontSize="11" FontWeight="Bold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Foreground="{DynamicResource SuccessBrush}"/>
                                </Border>
                            </Grid>
                        </Border>
                    </controls:AdaptiveColumnsPanel>

                    <WrapPanel Orientation="Horizontal">
                        <Button Content="Start Session" Classes="primary" Padding="32,11"
                                FontSize="14" Margin="0,0,10,8"
                                Command="{Binding StartTimersCommand}"
                                IsEnabled="{Binding IsStartButtonEnabled}"/>
                        <Button Content="Stop" Classes="secondary" Padding="24,11"
                                FontSize="13" Margin="0,0,0,8"
                                Command="{Binding StopTimersCommand}"
                                IsEnabled="{Binding IsRunning}"/>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- ===== SESSION STATS ===== -->
            <Border Classes="card" Margin="0,0,0,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14" Spacing="8">
                        <Border Width="3" Height="14" CornerRadius="2"
                                Background="{DynamicResource InfoBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="SESSION STATS" FontSize="10" FontWeight="Bold" LetterSpacing="1"
                                   Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <controls:AdaptiveColumnsPanel MinColumnWidth="140" MaxColumns="4"
                                                   ColumnSpacing="8" RowSpacing="8">
                        <Border Classes="card-inner">
                            <StackPanel>
                                <TextBlock Text="CYCLES" FontSize="9" FontWeight="Bold" LetterSpacing="1"
                                           Foreground="{DynamicResource TextMutedBrush}"/>
                                <TextBlock Text="{Binding CyclesCompleted}"
                                           FontSize="24" FontWeight="Bold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Classes="card-inner">
                            <StackPanel>
                                <TextBlock Text="STAND TIME" FontSize="9" FontWeight="Bold" LetterSpacing="1"
                                           Foreground="{DynamicResource SuccessBrush}"/>
                                <TextBlock Text="{Binding TotalStandingDisplay}"
                                           FontSize="22" FontWeight="Bold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Classes="card-inner">
                            <StackPanel>
                                <TextBlock Text="SIT TIME" FontSize="9" FontWeight="Bold" LetterSpacing="1"
                                           Foreground="{DynamicResource InfoBrush}"/>
                                <TextBlock Text="{Binding TotalSittingDisplay}"
                                           FontSize="22" FontWeight="Bold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Classes="card-inner">
                            <StackPanel>
                                <TextBlock Text="SESSION" FontSize="9" FontWeight="Bold" LetterSpacing="1"
                                           Foreground="{DynamicResource TextMutedBrush}"/>
                                <TextBlock Text="{Binding SessionElapsedDisplay}"
                                           FontSize="22" FontWeight="Bold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </controls:AdaptiveColumnsPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </controls:PageHost>
</UserControl>
