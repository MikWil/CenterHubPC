<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewmodel="clr-namespace:CenterHubNew.MVVM.ViewModel"
             xmlns:controls="clr-namespace:CenterHubNew.MVVM.Controls"
             x:Class="CenterHubNew.MVVM.View.NetworkView"
             x:DataType="viewmodel:NetworkViewModel"
             mc:Ignorable="d"
             Background="Transparent">

    <Grid>
        <!-- ============== MAIN CONTENT ============== -->
        <controls:PageHost Title="Network"
                           Subtitle="Live Wi-Fi signal, connection details, and one-click fixes"
                           Mode="Data">
            <controls:PageHost.HeaderActions>
                <Button Classes="secondary"
                        Padding="12,9" FontSize="12"
                        HorizontalAlignment="Right"
                        Command="{Binding RefreshCommand}"
                        ToolTip.Tip="Refresh now (also auto-refreshes every 3s)">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="&#xE72C;"
                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets, Segoe UI Symbol"
                                   FontSize="13"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="Refresh" FontSize="12" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </controls:PageHost.HeaderActions>

            <!-- Cards flow into 3 / 2 / 1 columns; the hero card, the fixes and the tips take full or double rows -->
            <controls:AdaptiveColumnsPanel MinColumnWidth="380" MaxColumns="3"
                                           ColumnSpacing="12" RowSpacing="12">

                <!-- ===== HERO CARD — current connection + signal ===== -->
                <Border controls:AdaptiveColumnsPanel.FullRow="True"
                        CornerRadius="14" Padding="0"
                        BorderThickness="1" BorderBrush="{DynamicResource BorderHairline}"
                        ClipToBounds="True" Background="{DynamicResource HeroBackgroundBrush}">
                    <Grid RowDefinitions="4,Auto">

                        <!-- Top accent stripe -->
                        <Border Grid.Row="0" Background="{DynamicResource AccentBrush}"/>

                        <Grid Grid.Row="1" Margin="24,24,24,22" ColumnDefinitions="Auto,*">

                            <!-- Big signal icon block -->
                            <Border Grid.Column="0"
                                    Width="80" Height="80" CornerRadius="14"
                                    Background="{DynamicResource AccentSubtleBrush}"
                                    BorderThickness="1" BorderBrush="{DynamicResource AccentBrush}"
                                    VerticalAlignment="Center">
                                <TextBlock x:Name="WifiGlyph"
                                           Text="{Binding ConnectionGlyph}"
                                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets, Segoe UI Symbol"
                                           FontSize="36"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{DynamicResource AccentBrush}"/>
                            </Border>

                            <!-- Connection details -->
                            <StackPanel Grid.Column="1" Margin="20,0,0,0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,4">
                                    <Border Width="8" Height="8" CornerRadius="4"
                                            Background="{DynamicResource SuccessBrush}" VerticalAlignment="Center"
                                            IsVisible="{Binding IsConnected}"/>
                                    <Border Width="8" Height="8" CornerRadius="4"
                                            Background="{DynamicResource ErrorBrush}" VerticalAlignment="Center"
                                            IsVisible="{Binding !IsConnected}"/>
                                    <TextBlock Text="{Binding ConnectionTypeLabel}"
                                               FontSize="11" FontWeight="Bold" LetterSpacing="2"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>

                                <!-- SSID for Wi-Fi or adapter name for ethernet -->
                                <TextBlock Text="{Binding Ssid}"
                                           FontSize="28" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           TextTrimming="CharacterEllipsis"
                                           IsVisible="{Binding IsWifi}"/>
                                <TextBlock Text="{Binding AdapterName}"
                                           FontSize="22" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           TextTrimming="CharacterEllipsis"
                                           IsVisible="{Binding !IsWifi}"/>

                                <!-- Signal bars + quality (Wi-Fi only); wraps on a narrow page -->
                                <WrapPanel Orientation="Horizontal" Margin="0,10,0,0"
                                           IsVisible="{Binding IsWifi}">
                                    <TextBlock Text="{Binding SignalBars}"
                                               FontSize="20"
                                               LetterSpacing="2"
                                               Margin="0,0,14,0"
                                               Foreground="{DynamicResource AccentBrush}"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding SignalQuality, StringFormat='{}{0}%'}"
                                               FontSize="22" FontWeight="Bold"
                                               Margin="0,0,14,0"
                                               Foreground="{DynamicResource AccentBrush}"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding SignalLabel}"
                                               FontSize="13"
                                               Margin="0,0,14,0"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding SignalDbm, StringFormat='≈ {0} dBm'}"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               VerticalAlignment="Center"/>
                                </WrapPanel>

                                <!-- Status line -->
                                <TextBlock Text="{Binding StatusMessage}"
                                           FontSize="11" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           Margin="0,10,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <!-- ===== CONNECTION ===== -->
                <Border Classes="card" Margin="0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14" Spacing="8">
                            <Border Width="3" Height="14" CornerRadius="2"
                                    Background="{DynamicResource InfoBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="CONNECTION" FontSize="10" FontWeight="Bold" LetterSpacing="1"
                                       Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                        </StackPanel>

                        <controls:AdaptiveColumnsPanel MinColumnWidth="120" MaxColumns="3"
                                                       ColumnSpacing="8" RowSpacing="8">
                            <Border Classes="card-inner">
                                <StackPanel>
                                    <TextBlock Text="DOWNLOAD" FontSize="9" FontWeight="Bold" LetterSpacing="1"
                                               Foreground="{DynamicResource TextMutedBrush}"/>
                                    <TextBlock Text="{Binding RxRateDisplay}"
                                               FontSize="17" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Classes="card-inner">
                                <StackPanel>
                                    <TextBlock Text="UPLOAD" FontSize="9" FontWeight="Bold" LetterSpacing="1"
                                               Foreground="{DynamicResource TextMutedBrush}"/>
                                    <TextBlock Text="{Binding TxRateDisplay}"
                                               FontSize="17" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Classes="card-inner">
                                <StackPanel>
                                    <TextBlock Text="STANDARD" FontSize="9" FontWeight="Bold" LetterSpacing="1"
                                               Foreground="{DynamicResource TextMutedBrush}"/>
                                    <TextBlock Text="{Binding PhyType}"
                                               FontSize="14" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               Margin="0,4,0,0"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Border>
                        </controls:AdaptiveColumnsPanel>
                    </StackPanel>
                </Border>

                <!-- ===== IP ADDRESSING ===== -->
                <Border Classes="card" Margin="0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14" Spacing="8">
                            <Border Width="3" Height="14" CornerRadius="2"
                                    Background="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="IP ADDRESSING" FontSize="10" FontWeight="Bold" LetterSpacing="1"
                                       Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Public IP — featured row with refresh button -->
                        <Border Classes="card-inner" Margin="0,0,0,8"
                                BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="PUBLIC IPV4 (WAN)"
                                               FontSize="9" FontWeight="Bold" LetterSpacing="1"
                                               Foreground="{DynamicResource AccentBrush}"/>
                                    <TextBlock Text="{Binding PublicIpv4}"
                                               FontSize="18" FontWeight="SemiBold"
                                               FontFamily="Consolas, Menlo, Courier New, monospace"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,4,0,2"/>
                                    <TextBlock Text="The IP the internet sees you as — what websites log when you visit."
                                               FontSize="10" TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextMutedBrush}"/>
                                </StackPanel>
                                <Button Grid.Column="1" Classes="secondary"
                                        Padding="10,7" VerticalAlignment="Center" Margin="8,0,0,0"
                                        Command="{Binding RefreshPublicIpCommand}"
                                        IsEnabled="{Binding !IsPublicIpLoading}"
                                        ToolTip.Tip="Refresh public IP via ipify">
                                    <TextBlock Text="&#xE72C;"
                                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets, Segoe UI Symbol"
                                               FontSize="13"/>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- Local IPv4 / Subnet / Gateway -->
                        <controls:AdaptiveColumnsPanel MinColumnWidth="150" MaxColumns="3"
                                                       ColumnSpacing="8" RowSpacing="8" Margin="0,0,0,8">
                            <Border Classes="card-inner">
                                <StackPanel>
                                    <TextBlock Text="LOCAL IPV4" FontSize="9" FontWeight="Bold" LetterSpacing="1"
                                               Foreground="{DynamicResource TextMutedBrush}"/>
                                    <TextBlock Text="{Binding Ipv4}"
                                               FontSize="14" FontWeight="SemiBold"
                                               FontFamily="Consolas, Menlo, Courier New, monospace"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Classes="card-inner">
                                <StackPanel>
                                    <TextBlock Text="SUBNET MASK" FontSize="9" FontWeight="Bold" LetterSpacing="1"
                                               Foreground="{DynamicResource TextMutedBrush}"/>
                                    <TextBlock Text="{Binding SubnetMask}"
                                               FontSize="14" FontWeight="SemiBold"
                                               FontFamily="Consolas, Menlo, Courier New, monospace"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Classes="card-inner">
                                <StackPanel>
                                    <TextBlock Text="GATEWAY" FontSize="9" FontWeight="Bold" LetterSpacing="1"
                                               Foreground="{DynamicResource TextMutedBrush}"/>
                                    <TextBlock Text="{Binding Gateway}"
                                               FontSize="14" FontWeight="SemiBold"
                                               FontFamily="Consolas, Menlo, Courier New, monospace"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                        </controls:AdaptiveColumnsPanel>

                        <!-- IPv6 — shown only if assigned -->
                        <Border Classes="card-inner"
                                IsVisible="{Binding Ipv6, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                            <StackPanel>
                                <TextBlock Text="IPV6" FontSize="9" FontWeight="Bold" LetterSpacing="1"
                                           Foreground="{DynamicResource TextMutedBrush}"/>
                                <TextBlock Text="{Binding Ipv6}"
                                           FontSize="13" FontWeight="SemiBold"
                                           FontFamily="Consolas, Menlo, Courier New, monospace"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="0,4,0,0"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- ===== DNS, DHCP, HOST ===== -->
                <Border Classes="card" Margin="0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14" Spacing="8">
                            <Border Width="3" Height="14" CornerRadius="2"
                                    Background="{DynamicResource SuccessBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="DNS · DHCP · HOST" FontSize="10" FontWeight="Bold" LetterSpacing="1"
                                       Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- DNS row (wide because servers can be multiple) -->
                        <Border Classes="card-inner" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="DNS SERVERS" FontSize="9" FontWeight="Bold" LetterSpacing="1"
                                           Foreground="{DynamicResource TextMutedBrush}"/>
                                <TextBlock Text="{Binding DnsServers}"
                                           FontSize="14" FontWeight="SemiBold"
                                           FontFamily="Consolas, Menlo, Courier New, monospace"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           Margin="0,4,0,0"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- DHCP server + lease + hostname + MAC -->
                        <controls:AdaptiveColumnsPanel MinColumnWidth="170" MaxColumns="2"
                                                       ColumnSpacing="8" RowSpacing="8">
                            <Border Classes="card-inner">
                                <StackPanel>
                                    <TextBlock Text="DHCP SERVER" FontSize="9" FontWeight="Bold" LetterSpacing="1"
                                               Foreground="{DynamicResource TextMutedBrush}"/>
                                    <TextBlock Text="{Binding DhcpServer}"
                                               FontSize="14" FontWeight="SemiBold"
                                               FontFamily="Consolas, Menlo, Courier New, monospace"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Classes="card-inner">
                                <StackPanel>
                                    <TextBlock Text="LEASE EXPIRES" FontSize="9" FontWeight="Bold" LetterSpacing="1"
                                               Foreground="{DynamicResource TextMutedBrush}"/>
                                    <TextBlock Text="{Binding DhcpLeaseEnd}"
                                               FontSize="14" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Classes="card-inner">
                                <StackPanel>
                                    <TextBlock Text="HOSTNAME" FontSize="9" FontWeight="Bold" LetterSpacing="1"
                                               Foreground="{DynamicResource TextMutedBrush}"/>
                                    <TextBlock Text="{Binding Hostname}"
                                               FontSize="14" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Classes="card-inner">
                                <StackPanel>
                                    <!-- Wi-Fi: show BSSID (access-point MAC). Ethernet: show adapter MAC. -->
                                    <TextBlock Text="ACCESS POINT (BSSID)" FontSize="9" FontWeight="Bold" LetterSpacing="1"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               IsVisible="{Binding IsWifi}"/>
                                    <TextBlock Text="ADAPTER MAC" FontSize="9" FontWeight="Bold" LetterSpacing="1"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               IsVisible="{Binding !IsWifi}"/>
                                    <TextBlock Text="{Binding Bssid}"
                                               FontSize="13" FontWeight="SemiBold"
                                               FontFamily="Consolas, Menlo, Courier New, monospace"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,4,0,0"
                                               IsVisible="{Binding IsWifi}"/>
                                    <TextBlock Text="{Binding MacAddress}"
                                               FontSize="13" FontWeight="SemiBold"
                                               FontFamily="Consolas, Menlo, Courier New, monospace"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,4,0,0"
                                               IsVisible="{Binding !IsWifi}"/>
                                </StackPanel>
                            </Border>
                        </controls:AdaptiveColumnsPanel>
                    </StackPanel>
                </Border>

                <!-- ===== FIX BUTTONS ===== -->
                <Border Classes="card" Margin="0" controls:AdaptiveColumnsPanel.ColumnSpan="2">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14" Spacing="8">
                            <Border Width="3" Height="14" CornerRadius="2"
                                    Background="{DynamicResource WarningBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="FIX MY CONNECTION" FontSize="10" FontWeight="Bold" LetterSpacing="1"
                                       Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                        </StackPanel>

                        <controls:AdaptiveColumnsPanel MinColumnWidth="200" MaxColumns="3"
                                                       ColumnSpacing="12" RowSpacing="12">
                            <!-- Renew DHCP -->
                            <Border Classes="card-inner">
                                <StackPanel>
                                    <TextBlock Text="&#xE968;"
                                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets, Segoe UI Symbol"
                                               FontSize="22"
                                               Foreground="{DynamicResource InfoBrush}"
                                               Margin="0,0,0,8"/>
                                    <TextBlock Text="Renew DHCP" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="Release the current IP lease and ask the router for a new one."
                                               FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                                               TextWrapping="Wrap" Margin="0,3,0,12"/>
                                    <Button Content="Renew DHCP" Classes="secondary"
                                            Padding="14,8" FontSize="12"
                                            HorizontalAlignment="Left"
                                            IsEnabled="{Binding !IsBusy}"
                                            Command="{Binding ConfirmRenewDhcpCommand}"/>
                                </StackPanel>
                            </Border>

                            <!-- Flush DNS -->
                            <Border Classes="card-inner">
                                <StackPanel>
                                    <TextBlock Text="&#xE74D;"
                                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets, Segoe UI Symbol"
                                               FontSize="22"
                                               Foreground="{DynamicResource SuccessBrush}"
                                               Margin="0,0,0,8"/>
                                    <TextBlock Text="Flush DNS" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="Clear the local DNS cache — fixes 'site not loading' after DNS changes."
                                               FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                                               TextWrapping="Wrap" Margin="0,3,0,12"/>
                                    <Button Content="Flush DNS" Classes="secondary"
                                            Padding="14,8" FontSize="12"
                                            HorizontalAlignment="Left"
                                            IsEnabled="{Binding !IsBusy}"
                                            Command="{Binding ConfirmFlushDnsCommand}"/>
                                </StackPanel>
                            </Border>

                            <!-- Full Reset -->
                            <Border Classes="card-inner"
                                    BorderBrush="{DynamicResource WarningBrush}" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="&#xE777;"
                                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets, Segoe UI Symbol"
                                               FontSize="22"
                                               Foreground="{DynamicResource WarningBrush}"
                                               Margin="0,0,0,8"/>
                                    <TextBlock Text="Full Reset" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="Flush DNS + release + renew + re-register. The 'I'm stuck, fix it' button."
                                               FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                                               TextWrapping="Wrap" Margin="0,3,0,12"/>
                                    <Button Content="Reset Network" Classes="primary"
                                            Padding="14,8" FontSize="12"
                                            HorizontalAlignment="Left"
                                            IsEnabled="{Binding !IsBusy}"
                                            Command="{Binding ConfirmFullResetCommand}"/>
                                </StackPanel>
                            </Border>
                        </controls:AdaptiveColumnsPanel>
                    </StackPanel>
                </Border>

                <!-- ===== TIPS ===== -->
                <Border Classes="card" Margin="0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10" Spacing="8">
                            <Border Width="3" Height="14" CornerRadius="2"
                                    Background="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="WHEN TO USE WHICH" FontSize="10" FontWeight="Bold" LetterSpacing="1"
                                       Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock TextWrapping="Wrap" FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}">
                            <Run Text="• " Foreground="{DynamicResource InfoBrush}"/>
                            <Run Text="Renew DHCP" FontWeight="SemiBold" Foreground="{DynamicResource InfoBrush}"/>
                            <Run Text=" — Wi-Fi shows connected but you have no internet, after waking from sleep, or right after the router rebooted."/>
                            <LineBreak/>
                            <Run Text="• " Foreground="{DynamicResource SuccessBrush}"/>
                            <Run Text="Flush DNS" FontWeight="SemiBold" Foreground="{DynamicResource SuccessBrush}"/>
                            <Run Text=" — A specific site won't load while others do, you just changed DNS servers, or you suspect a DNS lookup is cached wrong."/>
                            <LineBreak/>
                            <Run Text="• " Foreground="{DynamicResource WarningBrush}"/>
                            <Run Text="Full Reset" FontWeight="SemiBold" Foreground="{DynamicResource WarningBrush}"/>
                            <Run Text=" — Anything else. The big red 'unstick' button — it runs all the steps and re-registers with DNS. Briefly takes you offline."/>
                            <LineBreak/>
                            <LineBreak/>
                            <Run Text="Each fix asks Windows for admin permission (UAC prompt). If you click No, nothing happens and you stay where you were."
                                 Foreground="{DynamicResource TextMutedBrush}" FontSize="11"/>
                        </TextBlock>
                    </StackPanel>
                </Border>

            </controls:AdaptiveColumnsPanel>
        </controls:PageHost>

        <!-- ===== CONFIRMATION OVERLAY ===== -->
        <Border Background="#A8000000" IsVisible="{Binding IsConfirmOpen}" ZIndex="500">
            <Border MaxWidth="480" Margin="16"
                    HorizontalAlignment="Stretch"
                    Background="{DynamicResource CardBackgroundBrush}"
                    BorderThickness="1" BorderBrush="{DynamicResource BorderHairline}"
                    CornerRadius="12" Padding="28,24"
                    VerticalAlignment="Center"
                    BoxShadow="0 12 40 0 #80000000">
                <StackPanel Spacing="0">
                    <Grid ColumnDefinitions="Auto,12,*" Margin="0,0,0,12">
                        <Border Grid.Column="0" Width="36" Height="36" CornerRadius="18"
                                Background="{DynamicResource WarningSubtleBrush}"
                                BorderThickness="1" BorderBrush="{DynamicResource WarningBrush}"
                                VerticalAlignment="Center">
                            <TextBlock Text="!" FontSize="20" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{DynamicResource WarningBrush}"/>
                        </Border>
                        <TextBlock Grid.Column="2" Text="{Binding ConfirmTitle}"
                                   FontSize="17" FontWeight="SemiBold"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   VerticalAlignment="Center"/>
                    </Grid>

                    <TextBlock Text="{Binding ConfirmBody}"
                               TextWrapping="Wrap" FontSize="13"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="0,0,0,20"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
                        <Button Content="Cancel" Classes="secondary"
                                Padding="22,9"
                                Command="{Binding CancelConfirmCommand}"/>
                        <Button Content="Run it" Classes="primary"
                                Padding="22,9"
                                Command="{Binding RunConfirmedCommand}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

    </Grid>
</UserControl>
